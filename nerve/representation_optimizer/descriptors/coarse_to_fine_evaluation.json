  "hardware": {
    "compatible_processes": [
      {"name": "indirect_execution", "requirement": "optional", "operations": ["fine_work_generation", "indirect_dispatch"], "numeric_formats": ["u32"]},
      {"name": "simd_vector", "requirement": "alternative", "operations": ["coarse_evaluation", "fine_evaluation"], "numeric_formats": ["bf16", "f16", "f32"]},
      {"name": "texture_sampling", "requirement": "alternative", "operations": ["coarse_field_sampling", "mip_selection"], "numeric_formats": ["f16", "f32"]}
