#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Resource {
    uint values[];
};

struct ResourceRecord {
    uint64_t device_address;
    uint64_t byte_count;
    uint64_t generation;
    uint resident;
    uint reserved;
};

layout(set = 0, binding = 0, std430) readonly buffer AddressTable {
    ResourceRecord records[];
} table;

layout(set = 0, binding = 1, std430) writeonly buffer Output {
    uint values[];
} output_data;

layout(push_constant) uniform Parameters {
    uint slot;
} parameters;

void main() {
    ResourceRecord record = table.records[parameters.slot];
    if (record.resident == 0) {
        output_data.values[0] = 0xdeadbeef;
        output_data.values[1] = 0;
        output_data.values[2] = 0;
        output_data.values[3] = uint(record.generation);
        return;
    }
    Resource resource_data = Resource(record.device_address);
    uint last_index = uint(record.byte_count / 4ul) - 1;
    output_data.values[0] = resource_data.values[0];
    output_data.values[1] = resource_data.values[last_index];
    output_data.values[2] = record.resident;
    output_data.values[3] = uint(record.generation);
}
