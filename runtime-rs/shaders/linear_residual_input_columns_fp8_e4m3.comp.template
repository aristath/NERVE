#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_spirv_intrinsics : require

spirv_instruction(
    extensions = ["SPV_VALVE_mixed_float_dot_product"],
    capabilities = [6915],
    id = 6918
)
float fp8_dot4_acc32(fe4m3vec4 a, fe4m3vec4 b, float accumulator);

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputFrame { uint words[]; } input_frame;
layout(set = 0, binding = 1) readonly buffer ResidualFrame { uint words[]; } residual_frame;
layout(set = 0, binding = 2, std430) writeonly buffer OutputPartials { float values[]; } output_partials;
layout(set = 0, binding = 3) readonly buffer InputBlockMajorWeight { uint words[]; } weight;
layout(set = 0, binding = 4) readonly buffer InputBlockMajorScale { uint words[]; } weight_scale_inv;

layout(push_constant) uniform PartitionControl {
    uint input_start;
    uint input_count;
} partition_control;

const uint BLOCK_ROWS = {{BLOCK_ROWS}}u;
const uint BLOCK_COLUMNS = {{BLOCK_COLUMNS}}u;
const uint TOTAL_INPUT_SIZE = {{INPUT_SIZE}}u;
const uint OUTPUT_SIZE = {{OUTPUT_SIZE}}u;
const uint OUTPUT_TILE_ROWS = {{OUTPUT_TILE_ROWS}}u;
const uint TOTAL_INPUT_FP8_WORDS = TOTAL_INPUT_SIZE / 4u;
const uint TOTAL_INPUT_BLOCKS = TOTAL_INPUT_SIZE / BLOCK_COLUMNS;
const uint BLOCK_FP8_WORDS = BLOCK_COLUMNS / 4u;
const uint OUTPUT_BLOCKS = (OUTPUT_SIZE + BLOCK_ROWS - 1u) / BLOCK_ROWS;

shared fe4m3vec4 quantized_input[TOTAL_INPUT_FP8_WORDS];
shared float input_scales[TOTAL_INPUT_BLOCKS];

float bf16_to_f32(uint value) { return uintBitsToFloat((value & 0xffffu) << 16u); }

float read_bf16_word(uint packed, uint index) {
    return bf16_to_f32(packed >> ((index & 1u) * 16u));
}

vec4 read_inputx4(uint batch_index, uint column) {
    const uint offset = batch_index * (TOTAL_INPUT_SIZE / 2u) + (column >> 1u);
    const uint lo = input_frame.words[offset];
    const uint hi = input_frame.words[offset + 1u];
    return vec4(
        bf16_to_f32(lo),
        bf16_to_f32(lo >> 16u),
        bf16_to_f32(hi),
        bf16_to_f32(hi >> 16u)
    );
}

float read_weight_scale(uint row, uint block) {
    const uint index = block * OUTPUT_BLOCKS + row / BLOCK_ROWS;
    return read_bf16_word(weight_scale_inv.words[index >> 1u], index);
}

fe4m3vec4 read_weightx4(uint row, uint word) {
    const uint block = word / BLOCK_FP8_WORDS;
    const uint word_in_block = word % BLOCK_FP8_WORDS;
    const uint index =
        block * OUTPUT_SIZE * BLOCK_COLUMNS + row * BLOCK_COLUMNS + word_in_block * 4u;
    const uint packed = weight.words[index >> 2u];
    return uintBitsToFloate4m3EXT(u8vec4(
        uint8_t(packed),
        uint8_t(packed >> 8u),
        uint8_t(packed >> 16u),
        uint8_t(packed >> 24u)
    ));
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint cluster = lane >> 5u;
    const uint cluster_lane = lane & 31u;
    const uint batch_index = gl_WorkGroupID.y;
    const uint input_blocks = partition_control.input_count / BLOCK_COLUMNS;
    const uint input_words = partition_control.input_count / 4u;
    for (uint block = cluster; block < input_blocks; block += 32u) {
        const uint word = block * BLOCK_FP8_WORDS + cluster_lane;
        const vec4 input_value = read_inputx4(batch_index, word * 4u);
        const float lane_max = max(
            max(abs(input_value.x), abs(input_value.y)),
            max(abs(input_value.z), abs(input_value.w))
        );
        const float block_max = subgroupClusteredMax(lane_max, 32u);
        const float scale = block_max > 0.0 ? block_max / 448.0 : 1.0;
        if (cluster_lane == 0u) {
            input_scales[block] = scale;
        }
        quantized_input[word] = fe4m3vec4(input_value / scale);
    }
    barrier();

    const uint local_row = gl_SubgroupID;
    const uint row = gl_WorkGroupID.x * OUTPUT_TILE_ROWS + local_row;
    float sum = 0.0;
    if (local_row < OUTPUT_TILE_ROWS && row < OUTPUT_SIZE) {
        for (
            uint word = gl_SubgroupInvocationID;
            word < input_words;
            word += gl_SubgroupSize
        ) {
            const uint block = word / BLOCK_FP8_WORDS;
            sum = fma(
                fp8_dot4_acc32(
                    quantized_input[word],
                    read_weightx4(row, word),
                    0.0
                ),
                input_scales[block] * read_weight_scale(row, block),
                sum
            );
        }
    }
    sum = subgroupAdd(sum);
    if (
        local_row < OUTPUT_TILE_ROWS
        && row < OUTPUT_SIZE
        && gl_SubgroupInvocationID == 0u
    ) {
        output_partials.values[batch_index * OUTPUT_SIZE + row] = sum;
    }
}
