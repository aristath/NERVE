#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require

spirv_instruction(
    extensions = ["SPV_VALVE_mixed_float_dot_product"],
    capabilities = [6915],
    id = 6918
)
float fp8_dot4_acc32(fe4m3vec4 a, fe4m3vec4 b, float accumulator);

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

#define PREQUANTIZED_INPUT {{PREQUANTIZED_INPUT}}
#define PREEXPANDED_FP8 {{PREEXPANDED_FP8}}
#define DYNAMIC_WEIGHT_REPRESENTATION {{DYNAMIC_WEIGHT_REPRESENTATION}}
#if PREQUANTIZED_INPUT
layout(set = 0, binding = 0) readonly buffer QuantizedHidden { uint words[]; } quantized_hidden;
layout(set = 0, binding = 1) readonly buffer HiddenScales { float values[]; } hidden_scales;
layout(set = 0, binding = 2) readonly buffer ExpertRoutes { uint words[]; } expert_routes;
layout(set = 0, binding = 3) buffer ExpertIntermediates { uint words[]; } expert_intermediates;
layout(set = 0, binding = 4) readonly buffer DynamicResourceAddresses { uint words[]; } dynamic_resource_addresses;
layout(set = 0, binding = 5) readonly buffer DynamicParameterSlots { uint words[]; } dynamic_parameter_slots;
#else
layout(set = 0, binding = 0) readonly buffer HiddenFrame { uint words[]; } hidden_frame;
layout(set = 0, binding = 1) readonly buffer ExpertRoutes { uint words[]; } expert_routes;
layout(set = 0, binding = 2) buffer ExpertIntermediates { uint words[]; } expert_intermediates;
layout(set = 0, binding = 3) readonly buffer DynamicResourceAddresses { uint words[]; } dynamic_resource_addresses;
layout(set = 0, binding = 4) readonly buffer DynamicParameterSlots { uint words[]; } dynamic_parameter_slots;
#endif

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer DynamicU32Buffer {
    uint words[];
};

layout(push_constant) uniform ExpertRange {
    uint expert_start;
    uint expert_count;
} expert_range;

const uint HIDDEN_SIZE = {{HIDDEN_SIZE}}u;
const uint INTERMEDIATE_SIZE = {{INTERMEDIATE_SIZE}}u;
const uint NUM_EXPERTS = {{NUM_EXPERTS}}u;
const uint EXPERTS_PER_TOKEN = {{EXPERTS_PER_TOKEN}}u;
const uint TILE_ROWS = {{TILE_ROWS}}u;
const float SWIGLU_LIMIT = {{SWIGLU_LIMIT}};
const uint TILES_PER_ROUTE = (INTERMEDIATE_SIZE + TILE_ROWS - 1u) / TILE_ROWS;
const uint HIDDEN_WORDS = HIDDEN_SIZE / 2u;
const uint HIDDEN_FP8_WORDS = HIDDEN_SIZE / 4u;
const uint HIDDEN_BLOCKS = HIDDEN_SIZE / 128u;
const uint INTERMEDIATE_WORDS = INTERMEDIATE_SIZE / 2u;
const uint COMPACT_WEIGHT_ROW_BYTES = HIDDEN_SIZE / 2u;
const uint EXPANDED_WEIGHT_ROW_BYTES = HIDDEN_SIZE;
const uint SCALE_ROW_BYTES = HIDDEN_SIZE / 32u;
const uint ADDRESS_RECORD_WORDS = 8u;
const uint DYNAMIC_PARAMETER_COUNT = 4u;
const uint UNBOUND_PARAMETER_SLOT = 0xffffffffu;
const uint MXFP4_E4M3_BITS[8] = uint[8](
    0x00u, 0x30u, 0x38u, 0x3cu, 0x40u, 0x44u, 0x48u, 0x4cu
);

#if !PREQUANTIZED_INPUT
shared fe4m3vec4 cached_hidden[HIDDEN_FP8_WORDS];
shared float cached_hidden_scales[HIDDEN_BLOCKS];
#endif
shared float activated_rows[TILE_ROWS];

float bf16_to_f32(uint value) { return uintBitsToFloat((value & 0xffffu) << 16); }

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7fffu + lsb) >> 16;
}

float round_bf16(float value) { return bf16_to_f32(f32_to_bf16(value)); }

#if !PREQUANTIZED_INPUT
vec4 read_hiddenx4(uint column) {
    uint offset = column >> 1u;
    uint lo = hidden_frame.words[offset];
    uint hi = hidden_frame.words[offset + 1u];
    return vec4(
        bf16_to_f32(lo), bf16_to_f32(lo >> 16u),
        bf16_to_f32(hi), bf16_to_f32(hi >> 16u)
    );
}
#endif

fe4m3vec4 read_fp8x4(uint packed) {
    return uintBitsToFloate4m3EXT(u8vec4(
        uint8_t(packed),
        uint8_t(packed >> 8u),
        uint8_t(packed >> 16u),
        uint8_t(packed >> 24u)
    ));
}

uint dynamic_parameter_slot(uint expert, uint parameter) {
    return dynamic_parameter_slots.words[
        expert * DYNAMIC_PARAMETER_COUNT + parameter
    ];
}

uint address_table_slot_count() {
    return dynamic_resource_addresses.words.length() / ADDRESS_RECORD_WORDS;
}

uint64_t address_record_byte_count(uint record) {
    return uint64_t(dynamic_resource_addresses.words[record + 2u])
        | (uint64_t(dynamic_resource_addresses.words[record + 3u]) << 32u);
}

bool address_record_is_resident(uint record, uint64_t required_byte_count) {
    uint64_t address = uint64_t(dynamic_resource_addresses.words[record])
        | (uint64_t(dynamic_resource_addresses.words[record + 1u]) << 32u);
    uint generation_nonzero = dynamic_resource_addresses.words[record + 4u]
        | dynamic_resource_addresses.words[record + 5u];
    return address != uint64_t(0)
        && (address & uint64_t(3)) == uint64_t(0)
        && address_record_byte_count(record) >= required_byte_count
        && generation_nonzero != 0u
        && dynamic_resource_addresses.words[record + 6u] == 1u;
}

bool dynamic_parameter_record_is_valid(
    uint expert,
    uint parameter,
    uint64_t required_byte_count
) {
    uint parameter_index = expert * DYNAMIC_PARAMETER_COUNT + parameter;
    if (parameter_index >= dynamic_parameter_slots.words.length()) return false;
    uint slot = dynamic_parameter_slots.words[parameter_index];
    if (slot == UNBOUND_PARAMETER_SLOT || slot >= address_table_slot_count()) return false;
    return address_record_is_resident(slot * ADDRESS_RECORD_WORDS, required_byte_count);
}

uint dynamic_parameter_representation(uint expert, uint parameter) {
    uint parameter_index = expert * DYNAMIC_PARAMETER_COUNT + parameter;
    if (parameter_index >= dynamic_parameter_slots.words.length()) return 0u;
    uint slot = dynamic_parameter_slots.words[parameter_index];
    if (slot == UNBOUND_PARAMETER_SLOT || slot >= address_table_slot_count()) return 0u;
    uint record = slot * ADDRESS_RECORD_WORDS;
    return dynamic_resource_addresses.words[record + 7u];
}

bool dynamic_weight_representation_is_valid(uint expert, uint parameter) {
#if DYNAMIC_WEIGHT_REPRESENTATION
    return dynamic_parameter_representation(expert, parameter) <= 1u;
#else
    return true;
#endif
}

bool dynamic_weight_is_preexpanded(uint expert, uint parameter) {
#if PREEXPANDED_FP8
    return true;
#elif DYNAMIC_WEIGHT_REPRESENTATION
    return dynamic_parameter_representation(expert, parameter) == 1u;
#else
    return false;
#endif
}

bool dynamic_expert_is_valid(uint expert) {
    bool gate_preexpanded = dynamic_weight_is_preexpanded(expert, 0u);
    bool up_preexpanded = dynamic_weight_is_preexpanded(expert, 2u);
    uint64_t gate_weight_bytes = uint64_t(INTERMEDIATE_SIZE) * uint64_t(
        gate_preexpanded ? EXPANDED_WEIGHT_ROW_BYTES : COMPACT_WEIGHT_ROW_BYTES
    );
    uint64_t up_weight_bytes = uint64_t(INTERMEDIATE_SIZE) * uint64_t(
        up_preexpanded ? EXPANDED_WEIGHT_ROW_BYTES : COMPACT_WEIGHT_ROW_BYTES
    );
    uint64_t scale_bytes = uint64_t(INTERMEDIATE_SIZE) * uint64_t(SCALE_ROW_BYTES);
    return dynamic_weight_representation_is_valid(expert, 0u)
        && dynamic_weight_representation_is_valid(expert, 2u)
        && gate_preexpanded == up_preexpanded
        && dynamic_parameter_record_is_valid(expert, 0u, gate_weight_bytes)
        && dynamic_parameter_record_is_valid(expert, 1u, scale_bytes)
        && dynamic_parameter_record_is_valid(expert, 2u, up_weight_bytes)
        && dynamic_parameter_record_is_valid(expert, 3u, scale_bytes);
}

DynamicU32Buffer dynamic_parameter(uint expert, uint parameter) {
    uint record = dynamic_parameter_slot(expert, parameter) * ADDRESS_RECORD_WORDS;
    uint64_t address = uint64_t(dynamic_resource_addresses.words[record])
        | (uint64_t(dynamic_resource_addresses.words[record + 1u]) << 32u);
    return DynamicU32Buffer(address);
}

uint read_u8(DynamicU32Buffer source, uint index) {
    return (source.words[index >> 2u] >> ((index & 3u) * 8u)) & 0xffu;
}

uint mxfp4_e4m3_bits(uint nibble) {
    return MXFP4_E4M3_BITS[nibble & 7u] | ((nibble & 8u) << 4u);
}

fe4m3vec4 read_expanded_fp8x4(
    DynamicU32Buffer weight,
    uint row,
    uint column
) {
    uint packed = weight.words[(row * EXPANDED_WEIGHT_ROW_BYTES + column) >> 2u];
    return uintBitsToFloate4m3EXT(u8vec4(
        uint8_t(packed),
        uint8_t(packed >> 8u),
        uint8_t(packed >> 16u),
        uint8_t(packed >> 24u)
    ));
}

fe4m3vec4 read_compact_mxfp4x4(
    DynamicU32Buffer weight,
    uint row,
    uint column
) {
    uint byte_index = row * COMPACT_WEIGHT_ROW_BYTES + column / 2u;
    uint lo = read_u8(weight, byte_index);
    uint hi = read_u8(weight, byte_index + 1u);
    return uintBitsToFloate4m3EXT(u8vec4(
        uint8_t(mxfp4_e4m3_bits(lo & 0x0fu)),
        uint8_t(mxfp4_e4m3_bits(lo >> 4u)),
        uint8_t(mxfp4_e4m3_bits(hi & 0x0fu)),
        uint8_t(mxfp4_e4m3_bits(hi >> 4u))
    ));
}

fe4m3vec4 read_mxfp4x4(
    DynamicU32Buffer weight,
    uint row,
    uint column,
    bool preexpanded
) {
#if PREEXPANDED_FP8
    return read_expanded_fp8x4(weight, row, column);
#else
    return read_compact_mxfp4x4(weight, row, column);
#endif
}

float read_e8m0_scale(DynamicU32Buffer scale, uint row, uint block) {
    uint scale_byte = read_u8(scale, row * SCALE_ROW_BYTES + block);
    if (scale_byte == 0u) return uintBitsToFloat(0x00400000u);
    return uintBitsToFloat(scale_byte << 23u);
}

float rounded_fp8_scale(float block_max) {
    float ratio = max(block_max, 1e-4) / 448.0;
    uint bits = floatBitsToUint(ratio);
    int exponent = int((bits >> 23u) & 0xffu) - 127;
    if ((bits & 0x7fffffu) != 0u) exponent++;
    return uintBitsToFloat(uint(exponent + 127) << 23u);
}

#if !PREQUANTIZED_INPUT
void quantize_hidden(uint lane) {
    if (lane >= 64u) return;
    uint cluster = lane >> 5u;
    uint cluster_lane = lane & 31u;
    for (uint block = cluster; block < HIDDEN_BLOCKS; block += 2u) {
        uint word = block * 32u + cluster_lane;
        vec4 hidden = read_hiddenx4(word * 4u);
        float lane_max = max(
            max(abs(hidden.x), abs(hidden.y)),
            max(abs(hidden.z), abs(hidden.w))
        );
        float block_max = subgroupClusteredMax(lane_max, 32u);
        float scale = rounded_fp8_scale(block_max);
        if (cluster_lane == 0u) cached_hidden_scales[block] = scale;
        cached_hidden[word] = fe4m3vec4(hidden / scale);
    }
}
#endif

#if DYNAMIC_WEIGHT_REPRESENTATION
void accumulate_gate_up_compact(
    DynamicU32Buffer gate_weight,
    DynamicU32Buffer gate_scale,
    DynamicU32Buffer up_weight,
    DynamicU32Buffer up_scale,
    uint row,
    inout float gate,
    inout float up
) {
    for (
        uint word = gl_SubgroupInvocationID;
        word < HIDDEN_FP8_WORDS;
        word += gl_SubgroupSize
    ) {
        uint column = word * 4u;
        uint activation_block = column / 128u;
        uint weight_block = column / 32u;
#if PREQUANTIZED_INPUT
        float activation_scale = hidden_scales.values[activation_block];
        fe4m3vec4 hidden = read_fp8x4(quantized_hidden.words[word]);
#else
        float activation_scale = cached_hidden_scales[activation_block];
        fe4m3vec4 hidden = cached_hidden[word];
#endif
        gate = fma(
            fp8_dot4_acc32(
                hidden,
                read_compact_mxfp4x4(gate_weight, row, column),
                0.0
            ),
            activation_scale * read_e8m0_scale(gate_scale, row, weight_block),
            gate
        );
        up = fma(
            fp8_dot4_acc32(
                hidden,
                read_compact_mxfp4x4(up_weight, row, column),
                0.0
            ),
            activation_scale * read_e8m0_scale(up_scale, row, weight_block),
            up
        );
    }
}

void accumulate_gate_up_expanded(
    DynamicU32Buffer gate_weight,
    DynamicU32Buffer gate_scale,
    DynamicU32Buffer up_weight,
    DynamicU32Buffer up_scale,
    uint row,
    inout float gate,
    inout float up
) {
    for (
        uint word = gl_SubgroupInvocationID;
        word < HIDDEN_FP8_WORDS;
        word += gl_SubgroupSize
    ) {
        uint column = word * 4u;
        uint activation_block = column / 128u;
        uint weight_block = column / 32u;
#if PREQUANTIZED_INPUT
        float activation_scale = hidden_scales.values[activation_block];
        fe4m3vec4 hidden = read_fp8x4(quantized_hidden.words[word]);
#else
        float activation_scale = cached_hidden_scales[activation_block];
        fe4m3vec4 hidden = cached_hidden[word];
#endif
        gate = fma(
            fp8_dot4_acc32(
                hidden,
                read_expanded_fp8x4(gate_weight, row, column),
                0.0
            ),
            activation_scale * read_e8m0_scale(gate_scale, row, weight_block),
            gate
        );
        up = fma(
            fp8_dot4_acc32(
                hidden,
                read_expanded_fp8x4(up_weight, row, column),
                0.0
            ),
            activation_scale * read_e8m0_scale(up_scale, row, weight_block),
            up
        );
    }
}
#endif

void main() {
    uint route = gl_WorkGroupID.x / TILES_PER_ROUTE;
    uint tile = gl_WorkGroupID.x % TILES_PER_ROUTE;
    if (route >= EXPERTS_PER_TOKEN) return;
    uint expert = expert_routes.words[route] & 0xffffu;
    if (
        expert >= NUM_EXPERTS
        || expert < expert_range.expert_start
        || expert - expert_range.expert_start >= expert_range.expert_count
        || !dynamic_expert_is_valid(expert)
    ) return;
    DynamicU32Buffer gate_weight = dynamic_parameter(expert, 0u);
    DynamicU32Buffer gate_scale = dynamic_parameter(expert, 1u);
    DynamicU32Buffer up_weight = dynamic_parameter(expert, 2u);
    DynamicU32Buffer up_scale = dynamic_parameter(expert, 3u);
    bool gate_preexpanded = dynamic_weight_is_preexpanded(expert, 0u);
    bool up_preexpanded = dynamic_weight_is_preexpanded(expert, 2u);

    uint lane = gl_LocalInvocationID.x;
#if !PREQUANTIZED_INPUT
    quantize_hidden(lane);
    barrier();
#endif
    uint first_row = tile * TILE_ROWS;
    for (
        uint local_row = gl_SubgroupID;
        local_row < TILE_ROWS;
        local_row += gl_NumSubgroups
    ) {
        uint row = first_row + local_row;
        float gate = 0.0;
        float up = 0.0;
        if (row < INTERMEDIATE_SIZE) {
#if DYNAMIC_WEIGHT_REPRESENTATION
            if (gate_preexpanded) {
                accumulate_gate_up_expanded(
                    gate_weight,
                    gate_scale,
                    up_weight,
                    up_scale,
                    row,
                    gate,
                    up
                );
            } else {
                accumulate_gate_up_compact(
                    gate_weight,
                    gate_scale,
                    up_weight,
                    up_scale,
                    row,
                    gate,
                    up
                );
            }
#else
            for (
                uint word = gl_SubgroupInvocationID;
                word < HIDDEN_FP8_WORDS;
                word += gl_SubgroupSize
            ) {
                uint column = word * 4u;
                uint activation_block = column / 128u;
                uint weight_block = column / 32u;
#if PREQUANTIZED_INPUT
                float activation_scale = hidden_scales.values[activation_block];
                fe4m3vec4 hidden = read_fp8x4(quantized_hidden.words[word]);
#else
                float activation_scale = cached_hidden_scales[activation_block];
                fe4m3vec4 hidden = cached_hidden[word];
#endif
                gate = fma(
                    fp8_dot4_acc32(
                        hidden,
                        read_mxfp4x4(gate_weight, row, column, gate_preexpanded),
                        0.0
                    ),
                    activation_scale * read_e8m0_scale(gate_scale, row, weight_block),
                    gate
                );
                up = fma(
                    fp8_dot4_acc32(
                        hidden,
                        read_mxfp4x4(up_weight, row, column, up_preexpanded),
                        0.0
                    ),
                    activation_scale * read_e8m0_scale(up_scale, row, weight_block),
                    up
                );
            }
#endif
        }
        gate = subgroupAdd(gate);
        up = subgroupAdd(up);
        if (gl_SubgroupInvocationID == 0u) {
            if (row < INTERMEDIATE_SIZE) {
                float gate_value = round_bf16(gate);
                float up_value = round_bf16(up);
                if (SWIGLU_LIMIT > 0.0) {
                    gate_value = min(gate_value, SWIGLU_LIMIT);
                    up_value = clamp(up_value, -SWIGLU_LIMIT, SWIGLU_LIMIT);
                }
                activated_rows[local_row] = round_bf16(
                    (gate_value / (1.0 + exp(-gate_value))) * up_value
                );
            } else {
                activated_rows[local_row] = 0.0;
            }
        }
    }
    barrier();
    if (lane < TILE_ROWS / 2u) {
        uint row = first_row + lane * 2u;
        if (row < INTERMEDIATE_SIZE) {
            uint high = row + 1u < INTERMEDIATE_SIZE
                ? f32_to_bf16(activated_rows[lane * 2u + 1u])
                : 0u;
            expert_intermediates.words[route * INTERMEDIATE_WORDS + row / 2u] =
                (high << 16u) | f32_to_bf16(activated_rows[lane * 2u]);
        }
    }
}
