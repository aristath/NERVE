#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer RouterLogits {
    uint words[];
} router_logits;

{{BIAS_DECLARATION}}

layout(set = 0, binding = {{ROUTES_BINDING}}) buffer ExpertRoutes {
    uint words[];
} expert_routes;

layout(set = 0, binding = {{TELEMETRY_BINDING}}) buffer SelectionTelemetry {
    uint counts[];
} selection_telemetry;

layout(push_constant) uniform BatchControl { uint batch_width; } batch_control;

const uint NUM_EXPERTS = {{NUM_EXPERTS}}u;
const uint EXPERTS_PER_TOKEN = {{EXPERTS_PER_TOKEN}}u;
const bool ROUTER_SIGMOID = {{ROUTER_SIGMOID}} != 0;
const bool NORMALIZE_SELECTED = {{NORMALIZE_SELECTED}} != 0;
const float LOGIT_SOFTCAP = {{LOGIT_SOFTCAP}};
const uint ROUTER_WORDS = (NUM_EXPERTS + 1u) / 2u;

shared uint top_indices[EXPERTS_PER_TOKEN];
shared uint selected_experts[NUM_EXPERTS];
shared float router_values[NUM_EXPERTS];
shared float subgroup_best_scores[64];
shared uint subgroup_best_experts[64];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7fffu + lsb) >> 16;
}

float unpack_bf16(uint packed, uint index) {
    return bf16_to_f32((index & 1u) == 0u ? packed : packed >> 16);
}

float router_logit(uint batch_index, uint expert) {
    float value = unpack_bf16(
        router_logits.words[batch_index * ROUTER_WORDS + (expert >> 1u)],
        expert
    );
    return LOGIT_SOFTCAP > 0.0
        ? tanh(value / LOGIT_SOFTCAP) * LOGIT_SOFTCAP
        : value;
}

float sigmoid(float value) {
    return 1.0 / (1.0 + exp(-value));
}

float selection_score(uint expert) {
    float logit = router_values[expert];
    float routed = ROUTER_SIGMOID ? sigmoid(logit) : logit;
    return routed + {{READ_SELECTION_BIAS}};
}

void main() {
    uint batch_index = gl_WorkGroupID.y;
    if (batch_index >= batch_control.batch_width) return;
    uint lane = gl_LocalInvocationID.x;
    for (uint expert = lane; expert < NUM_EXPERTS; expert += gl_WorkGroupSize.x) {
        router_values[expert] = router_logit(batch_index, expert);
        selected_experts[expert] = 0u;
    }
    barrier();

    for (uint route = 0u; route < EXPERTS_PER_TOKEN; route++) {
        float best_score = -uintBitsToFloat(0x7f800000u);
        uint best_expert = 0xffffffffu;
        for (uint expert = lane; expert < NUM_EXPERTS; expert += gl_WorkGroupSize.x) {
            float score = selection_score(expert);
            if (
                selected_experts[expert] == 0u
                && (
                    score > best_score
                    || (score == best_score && expert < best_expert)
                )
            ) {
                best_score = score;
                best_expert = expert;
            }
        }
        float subgroup_score = subgroupMax(best_score);
        uint subgroup_expert = subgroupMin(
            best_score == subgroup_score ? best_expert : 0xffffffffu
        );
        if (gl_NumSubgroups == 1u) {
            if (lane == 0u) {
                top_indices[route] = subgroup_expert;
                selected_experts[subgroup_expert] = 1u;
            }
        } else {
            if (subgroupElect()) {
                subgroup_best_scores[gl_SubgroupID] = subgroup_score;
                subgroup_best_experts[gl_SubgroupID] = subgroup_expert;
            }
            barrier();
            if (lane == 0u) {
                float route_score = -uintBitsToFloat(0x7f800000u);
                uint route_expert = 0xffffffffu;
                for (uint subgroup = 0u; subgroup < gl_NumSubgroups; subgroup++) {
                    float score = subgroup_best_scores[subgroup];
                    uint expert = subgroup_best_experts[subgroup];
                    if (
                        score > route_score
                        || (score == route_score && expert < route_expert)
                    ) {
                        route_score = score;
                        route_expert = expert;
                    }
                }
                top_indices[route] = route_expert;
                selected_experts[route_expert] = 1u;
            }
        }
        barrier();
    }

    if (lane == 0u) {
        float maximum = router_values[top_indices[0]];
        float denominator = 0.0;
        if (NORMALIZE_SELECTED) {
            for (uint route = 0u; route < EXPERTS_PER_TOKEN; route++) {
                float logit = router_values[top_indices[route]];
                denominator += ROUTER_SIGMOID ? sigmoid(logit) : exp(logit - maximum);
            }
        } else if (!ROUTER_SIGMOID) {
            maximum = -uintBitsToFloat(0x7f800000u);
            for (uint expert = 0u; expert < NUM_EXPERTS; expert++) {
                maximum = max(maximum, router_values[expert]);
            }
            for (uint expert = 0u; expert < NUM_EXPERTS; expert++) {
                denominator += exp(router_values[expert] - maximum);
            }
        }

        for (uint route = 1u; route < EXPERTS_PER_TOKEN; route++) {
            uint expert = top_indices[route];
            uint insertion = route;
            while (insertion > 0u && top_indices[insertion - 1u] > expert) {
                top_indices[insertion] = top_indices[insertion - 1u];
                insertion--;
            }
            top_indices[insertion] = expert;
        }
        uint route_base = batch_index * EXPERTS_PER_TOKEN;
        for (uint route = 0u; route < EXPERTS_PER_TOKEN; route++) {
            uint expert = top_indices[route];
            float logit = router_values[expert];
            float weight = ROUTER_SIGMOID ? sigmoid(logit) : exp(logit - maximum);
            if (NORMALIZE_SELECTED || !ROUTER_SIGMOID) weight /= denominator;
            expert_routes.words[route_base + route] =
                (f32_to_bf16(weight) << 16u) | expert;
            atomicAdd(selection_telemetry.counts[expert], 1u);
        }
        for (uint left_route = 0u; left_route < EXPERTS_PER_TOKEN; left_route++) {
            uint left = top_indices[left_route];
            for (uint right_route = left_route + 1u; right_route < EXPERTS_PER_TOKEN; right_route++) {
                uint right = top_indices[right_route];
                if (left < right) {
                    uint preceding = left * (2u * NUM_EXPERTS - left - 1u) / 2u;
                    uint pair_index = preceding + right - left - 1u;
                    atomicAdd(selection_telemetry.counts[NUM_EXPERTS + pair_index], 1u);
                }
            }
        }
    }
}
