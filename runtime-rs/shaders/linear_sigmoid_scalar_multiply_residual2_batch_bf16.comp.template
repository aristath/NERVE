#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer GateInputFrames {
    uint words[];
} gate_input_frames;
layout(set = 0, binding = 1) readonly buffer ValueInputFrames {
    uint words[];
} value_input_frames;
layout(set = 0, binding = 2) readonly buffer FirstResidualFrames {
    uint words[];
} first_residual_frames;
layout(set = 0, binding = 3) readonly buffer SecondResidualFrames {
    uint words[];
} second_residual_frames;
layout(set = 0, binding = 4) buffer OutputFrames {
    uint words[];
} output_frames;
layout(set = 0, binding = 5) readonly buffer GateWeight {
    uint words[];
} gate_weight;

layout(push_constant) uniform BatchControl {
    uint batch_width;
} batch_control;

const uint BATCH_TILE_WIDTH = {{BATCH_TILE_WIDTH}}u;
const uint GATE_INPUT_SIZE = {{GATE_INPUT_SIZE}}u;
const uint VALUE_SIZE = {{VALUE_SIZE}}u;
const uint GATE_INPUT_WORDS = GATE_INPUT_SIZE / 2u;
const uint VALUE_WORDS = VALUE_SIZE / 2u;

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16u);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7fffu + lsb) >> 16u;
}

uint gated_residual_pair(
    uint value,
    uint first,
    uint second,
    float gate
) {
    uint gated_lo = f32_to_bf16(bf16_to_f32(value) * gate);
    uint gated_hi = f32_to_bf16(bf16_to_f32(value >> 16u) * gate);
    uint combined_lo = f32_to_bf16(
        bf16_to_f32(gated_lo) + bf16_to_f32(first)
    );
    uint combined_hi = f32_to_bf16(
        bf16_to_f32(gated_hi) + bf16_to_f32(first >> 16u)
    );
    uint output_lo = f32_to_bf16(
        bf16_to_f32(combined_lo) + bf16_to_f32(second)
    );
    uint output_hi = f32_to_bf16(
        bf16_to_f32(combined_hi) + bf16_to_f32(second >> 16u)
    );
    return (output_hi << 16u) | output_lo;
}

void main() {
    uint batch_start = gl_WorkGroupID.y * BATCH_TILE_WIDTH;
    uint batch_lane = gl_WorkGroupID.x;
    uint batch_index = batch_start + batch_lane;
    if (
        batch_lane >= BATCH_TILE_WIDTH
        || batch_index >= batch_control.batch_width
    ) {
        return;
    }

    uint lane = gl_LocalInvocationID.x;
    uint gate_input_base = batch_index * GATE_INPUT_WORDS;
    float gate_sum = 0.0;
    for (
        uint word = lane;
        word < GATE_INPUT_WORDS;
        word += gl_WorkGroupSize.x
    ) {
        uint input_pair = gate_input_frames.words[gate_input_base + word];
        uint weight_pair = gate_weight.words[word];
        gate_sum = fma(
            bf16_to_f32(input_pair),
            bf16_to_f32(weight_pair),
            gate_sum
        );
        gate_sum = fma(
            bf16_to_f32(input_pair >> 16u),
            bf16_to_f32(weight_pair >> 16u),
            gate_sum
        );
    }
    gate_sum = subgroupAdd(gate_sum);
    float rounded_gate = bf16_to_f32(f32_to_bf16(gate_sum));
    float gate = 1.0 / (1.0 + exp(-rounded_gate));

    uint value_base = batch_index * VALUE_WORDS;
    for (
        uint word = lane;
        word < VALUE_WORDS;
        word += gl_WorkGroupSize.x
    ) {
        uint index = value_base + word;
        output_frames.words[index] = gated_residual_pair(
            value_input_frames.words[index],
            first_residual_frames.words[index],
            second_residual_frames.words[index],
            gate
        );
    }
}
