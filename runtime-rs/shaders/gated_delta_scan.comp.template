#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require
{{FP8_EXTENSIONS}}

layout(local_size_x = {{LOCAL_SIZE_X}}, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QkvInput { uint words[]; } qkv_input;
layout(set = 0, binding = 1) readonly buffer ZInput { uint words[]; } z_input;
layout(set = 0, binding = 2) readonly buffer BInput { uint words[]; } b_input;
layout(set = 0, binding = 3) readonly buffer AInput { uint words[]; } a_input;
layout(set = 0, binding = 4) buffer OutputFrame { uint words[]; } output_frame;
{{PHYSICAL_OUTPUT_BINDINGS}}
layout(set = 0, binding = {{A_LOG_BINDING}}) readonly buffer ALog { uint words[]; } a_log;
layout(set = 0, binding = {{DT_BIAS_BINDING}}) readonly buffer DtBias { uint words[]; } dt_bias;
layout(set = 0, binding = {{NORM_WEIGHT_BINDING}}) readonly buffer NormWeight { uint words[]; } norm_weight;
layout(set = 0, binding = {{STATE_READ_BINDING}}) readonly buffer StateRead { float values[]; } state_read;
layout(set = 0, binding = {{STATE_WRITE_BINDING}}) buffer StateWrite { float values[]; } state_write;
layout(set = 0, binding = 30) buffer StateSnapshots { float values[]; } state_snapshots;

layout(push_constant) uniform BatchControl {
    uint batch_width;
    uint state_snapshots_enabled;
} batch_control;

const uint KEY_HEADS = {{KEY_HEADS}}u;
const uint KEY_HEAD_WIDTH = {{KEY_HEAD_WIDTH}}u;
const uint VALUE_HEADS = {{VALUE_HEADS}}u;
const uint VALUE_HEAD_WIDTH = {{VALUE_HEAD_WIDTH}}u;
const uint KEY_HEAD_REPEAT = {{KEY_HEAD_REPEAT}}u;
const uint LANES_PER_VALUE = {{LANES_PER_VALUE}}u;
const uint KEY_DIMS_PER_LANE = {{KEY_DIMS_PER_LANE}}u;
const uint KEY_WIDTH = KEY_HEADS * KEY_HEAD_WIDTH;
const uint VALUE_WIDTH = VALUE_HEADS * VALUE_HEAD_WIDTH;
const uint QKV_WIDTH = 2u * KEY_WIDTH + VALUE_WIDTH;
const float NORM_EPS = {{NORM_EPS}};
const uint STATE_PAGE_TABLE_WORDS = 9u;

shared float q_inv_norm;
shared float k_inv_norm;
shared float beta;
shared float decay;
shared float normalized_query[KEY_HEAD_WIDTH];
shared float normalized_key[KEY_HEAD_WIDTH];
shared float q_reduction[VALUE_HEAD_WIDTH];
shared float head_output[VALUE_HEAD_WIDTH];
shared float reduction[VALUE_HEAD_WIDTH];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7fffu + lsb) >> 16;
}

float unpack_bf16(uint packed, uint index) {
    return bf16_to_f32((index & 1u) == 0u ? packed : packed >> 16u);
}

float read_qkv(uint position, uint index) {
    uint scalar_index = position * QKV_WIDTH + index;
    return unpack_bf16(qkv_input.words[scalar_index >> 1u], scalar_index);
}

float read_z(uint position, uint index) {
    uint scalar_index = position * VALUE_WIDTH + index;
    return unpack_bf16(z_input.words[scalar_index >> 1u], scalar_index);
}

float read_b(uint position, uint index) {
    uint scalar_index = position * VALUE_HEADS + index;
    return unpack_bf16(b_input.words[scalar_index >> 1u], scalar_index);
}

float read_a(uint position, uint index) {
    uint scalar_index = position * VALUE_HEADS + index;
    return unpack_bf16(a_input.words[scalar_index >> 1u], scalar_index);
}

float read_a_log(uint index) { return {{READ_A_LOG}}; }
float read_dt_bias(uint index) { return {{READ_DT_BIAS}}; }
float read_norm_weight(uint index) { return {{READ_NORM_WEIGHT}}; }

float softplus(float value) {
    return value > 20.0 ? value : log(1.0 + exp(value));
}
{{FP8_HELPERS}}

uint state_read_index(uint logical_index) {
    uint logical_byte = logical_index * 4u;
    uint static_bytes = floatBitsToUint(state_read.values[2]);
    if (logical_byte < static_bytes) {
        return (floatBitsToUint(state_read.values[3]) + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - static_bytes;
    uint page_bytes = floatBitsToUint(state_read.values[4]);
    uint physical_page = floatBitsToUint(
        state_read.values[STATE_PAGE_TABLE_WORDS + dynamic_byte / page_bytes]
    );
    return (
        floatBitsToUint(state_read.values[8])
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}

uint state_write_index(uint logical_index) {
    uint logical_byte = logical_index * 4u;
    uint static_bytes = floatBitsToUint(state_write.values[2]);
    if (logical_byte < static_bytes) {
        return (floatBitsToUint(state_write.values[3]) + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - static_bytes;
    uint page_bytes = floatBitsToUint(state_write.values[4]);
    uint physical_page = floatBitsToUint(
        state_write.values[STATE_PAGE_TABLE_WORDS + dynamic_byte / page_bytes]
    );
    return (
        floatBitsToUint(state_write.values[8])
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}

void main() {
    uint value_head = gl_WorkGroupID.x;
    uint value_dim = gl_LocalInvocationID.x / LANES_PER_VALUE;
    uint value_lane = gl_LocalInvocationID.x % LANES_PER_VALUE;
    if (value_head >= VALUE_HEADS) return;

    uint key_head = value_head / KEY_HEAD_REPEAT;
    uint q_base = key_head * KEY_HEAD_WIDTH;
    uint k_base = KEY_WIDTH + q_base;
    uint v_base = 2u * KEY_WIDTH + value_head * VALUE_HEAD_WIDTH;
    uint state_base = value_head * KEY_HEAD_WIDTH * VALUE_HEAD_WIDTH;
    float recurrent_state[KEY_DIMS_PER_LANE];
    for (uint shard = 0u; shard < KEY_DIMS_PER_LANE; shard++) {
        uint key_dim = shard * LANES_PER_VALUE + value_lane;
        recurrent_state[shard] = state_read.values[state_read_index(
            state_base + key_dim * VALUE_HEAD_WIDTH + value_dim
        )];
    }
    float attention_scale = inversesqrt(float(KEY_HEAD_WIDTH));

    for (uint position = 0u; position < batch_control.batch_width; position++) {
        float q_square = 0.0;
        float k_square = 0.0;
        if (gl_LocalInvocationID.x < KEY_HEAD_WIDTH) {
            uint key_dim = gl_LocalInvocationID.x;
            float query = read_qkv(position, q_base + key_dim);
            float key = read_qkv(position, k_base + key_dim);
            normalized_query[key_dim] = query;
            normalized_key[key_dim] = key;
            q_square = query * query;
            k_square = key * key;
        }
        float q_partial = subgroupAdd(q_square);
        float k_partial = subgroupAdd(k_square);
        if (gl_SubgroupInvocationID == 0u) {
            q_reduction[gl_SubgroupID] = q_partial;
            reduction[gl_SubgroupID] = k_partial;
        }
        barrier();
        if (gl_LocalInvocationID.x == 0u) {
            float q_sum = 0.0;
            float k_sum = 0.0;
            for (uint subgroup = 0u; subgroup < gl_NumSubgroups; subgroup++) {
                q_sum += q_reduction[subgroup];
                k_sum += reduction[subgroup];
            }
            q_inv_norm = inversesqrt(q_sum + 0.000001);
            k_inv_norm = inversesqrt(k_sum + 0.000001);
            beta = 1.0 / (1.0 + exp(-read_b(position, value_head)));
            float decay_log = -exp(read_a_log(value_head)) * softplus(
                read_a(position, value_head) + read_dt_bias(value_head)
            );
            decay = exp(decay_log);
        }
        barrier();
        if (gl_LocalInvocationID.x < KEY_HEAD_WIDTH) {
            uint key_dim = gl_LocalInvocationID.x;
            normalized_query[key_dim] *= q_inv_norm;
            normalized_key[key_dim] *= k_inv_norm;
        }
        barrier();

        float key_memory = 0.0;
        for (uint shard = 0u; shard < KEY_DIMS_PER_LANE; shard++) {
            uint key_dim = shard * LANES_PER_VALUE + value_lane;
            recurrent_state[shard] *= decay;
            key_memory = fma(
                recurrent_state[shard],
                normalized_key[key_dim],
                key_memory
            );
        }
        key_memory = subgroupClusteredAdd(key_memory, {{LANES_PER_VALUE}}u);
        float value = read_qkv(position, v_base + value_dim);
        float delta = (value - key_memory) * beta;

        float mixed = 0.0;
        for (uint shard = 0u; shard < KEY_DIMS_PER_LANE; shard++) {
            uint key_dim = shard * LANES_PER_VALUE + value_lane;
            recurrent_state[shard] = recurrent_state[shard]
                + normalized_key[key_dim] * delta;
            mixed = fma(
                recurrent_state[shard],
                normalized_query[key_dim] * attention_scale,
                mixed
            );
        }
        mixed = subgroupClusteredAdd(mixed, {{LANES_PER_VALUE}}u);

        if (value_lane == 0u) {
            head_output[value_dim] = mixed;
        }
        float partial = subgroupAdd(value_lane == 0u ? mixed * mixed : 0.0);
        if (gl_SubgroupInvocationID == 0u) reduction[gl_SubgroupID] = partial;
        barrier();
        if (gl_LocalInvocationID.x == 0u) {
            float sum_squares = 0.0;
            for (uint subgroup = 0u; subgroup < gl_NumSubgroups; subgroup++) {
                sum_squares += reduction[subgroup];
            }
            q_inv_norm = inversesqrt(
                sum_squares / float(VALUE_HEAD_WIDTH) + NORM_EPS
            );
        }
        barrier();
        if (value_lane == 0u) {
            float z = read_z(
                position,
                value_head * VALUE_HEAD_WIDTH + value_dim
            );
            head_output[value_dim] = head_output[value_dim]
                * q_inv_norm
                * read_norm_weight(value_dim)
                * (z / (1.0 + exp(-z)));
        }
        barrier();

{{OUTPUT_STORE}}
        barrier();
        if (batch_control.state_snapshots_enabled != 0u) {
            uint snapshot_base =
                position * VALUE_HEADS * KEY_HEAD_WIDTH * VALUE_HEAD_WIDTH;
            for (uint shard = 0u; shard < KEY_DIMS_PER_LANE; shard++) {
                uint key_dim = shard * LANES_PER_VALUE + value_lane;
                state_snapshots.values[
                    snapshot_base
                    + state_base
                    + key_dim * VALUE_HEAD_WIDTH
                    + value_dim
                ] = recurrent_state[shard];
            }
        }
        barrier();
    }

    for (uint shard = 0u; shard < KEY_DIMS_PER_LANE; shard++) {
        uint key_dim = shard * LANES_PER_VALUE + value_lane;
        state_write.values[state_write_index(
            state_base + key_dim * VALUE_HEAD_WIDTH + value_dim
        )] =
            recurrent_state[shard];
    }
}
