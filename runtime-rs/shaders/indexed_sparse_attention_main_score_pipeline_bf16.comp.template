#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = {{LOCAL_SIZE}}, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QueryFrame { uint words[]; } query_frame;
layout(set = 0, binding = 1) readonly buffer LocalStateView { uint words[]; } local_state;
layout(set = 0, binding = 2) readonly buffer CompressedStateView { uint words[]; } compressed_state;
layout(set = 0, binding = 3) readonly buffer CompressedIndices { uint words[]; } compressed_indices;
layout(set = 0, binding = 4) buffer OutputFrame { uint words[]; } output_frame;
layout(set = 0, binding = 5) readonly buffer AttentionSinks { uint words[]; } attention_sinks;
layout(set = 0, binding = 8) readonly buffer StreamControl { uint words[]; } stream_control;

const uint QUERY_HEADS = {{QUERY_HEADS}}u;
const uint HEAD_WIDTH = {{HEAD_WIDTH}}u;
const uint LOCAL_WINDOW = {{LOCAL_WINDOW}}u;
const uint COMPRESSION_RATIO = {{COMPRESSION_RATIO}}u;
const uint MAX_COMPRESSED_INDICES = {{MAX_COMPRESSED_INDICES}}u;
const uint TILE_TOKENS = 64u;
const uint MAX_SCORE_SUBGROUP_COUNT = HEAD_WIDTH / 4u;
const uint STATE_PAGE_TABLE_WORDS = 9u;
const float ATTENTION_SCALE = {{ATTENTION_SCALE}};
const float LOWEST_FLOAT = -3.4028234663852886e38;

shared float score_partials[2u * MAX_SCORE_SUBGROUP_COUNT];
shared float tile_scores[TILE_TOKENS];
shared float tile_weights[TILE_TOKENS];
shared float running_maximum;
shared float running_denominator;
shared float previous_accumulator_scale;
shared float output_values[HEAD_WIDTH];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16u);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7fffu + lsb) >> 16u;
}

float read_bf16(uint packed, uint element_index) {
    return bf16_to_f32(packed >> ((element_index & 1u) * 16u));
}

uint local_state_word(uint logical_word) {
    uint logical_byte = logical_word * 4u;
    if (logical_byte < local_state.words[2]) {
        return (local_state.words[3] + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - local_state.words[2];
    uint page_bytes = local_state.words[4];
    uint physical_page = local_state.words[
        STATE_PAGE_TABLE_WORDS + dynamic_byte / page_bytes
    ];
    return (
        local_state.words[8]
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}

uint compressed_state_word(uint logical_word) {
    uint logical_byte = logical_word * 4u;
    if (logical_byte < compressed_state.words[2]) {
        return (compressed_state.words[3] + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - compressed_state.words[2];
    uint page_bytes = compressed_state.words[4];
    uint physical_page = compressed_state.words[
        STATE_PAGE_TABLE_WORDS + dynamic_byte / page_bytes
    ];
    return (
        compressed_state.words[8]
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}

float read_query(uint head, uint dim) {
    uint element = head * HEAD_WIDTH + dim;
    return read_bf16(query_frame.words[element >> 1u], element);
}

float read_local_key_value(uint absolute_tick, uint capacity, uint dim) {
    uint slot = absolute_tick % capacity;
    uint element = slot * HEAD_WIDTH + dim;
    return read_bf16(
        local_state.words[local_state_word(element >> 1u)],
        element
    );
}

uint compressed_index(uint position) {
    return compressed_indices.words[position];
}

bool valid_compressed_index(uint position, uint compressed_count) {
    uint index = compressed_index(position);
    return index != 0xffffffffu
        && index >= LOCAL_WINDOW
        && index - LOCAL_WINDOW < compressed_count;
}

float read_compressed_key_value(uint position, uint dim) {
    uint slot = compressed_index(position) - LOCAL_WINDOW;
    uint element = slot * HEAD_WIDTH + dim;
    return read_bf16(
        compressed_state.words[compressed_state_word(element >> 1u)],
        element
    );
}

bool token_valid(uint token, uint local_tokens, uint compressed_count) {
    if (token < local_tokens) {
        return true;
    }
    return valid_compressed_index(token - local_tokens, compressed_count);
}

float read_token_value(
    uint token,
    uint dim,
    uint local_tokens,
    uint oldest_tick,
    uint local_capacity
) {
    if (token < local_tokens) {
        return read_local_key_value(oldest_tick + token, local_capacity, dim);
    }
    return read_compressed_key_value(token - local_tokens, dim);
}

void produce_score_partials(
    uint buffer_index,
    uint token,
    float query_value,
    uint dim,
    uint local_tokens,
    uint compressed_count,
    uint oldest_tick,
    uint local_capacity
) {
    bool valid = token_valid(token, local_tokens, compressed_count);
    float key_value = valid
        ? read_token_value(token, dim, local_tokens, oldest_tick, local_capacity)
        : 0.0;
    float partial = subgroupAdd(query_value * key_value);
    if (subgroupElect()) {
        score_partials[
            buffer_index * MAX_SCORE_SUBGROUP_COUNT + gl_SubgroupID
        ] = partial;
    }
}

void main() {
    uint query_head = gl_WorkGroupID.x;
    uint dim = gl_LocalInvocationID.x;
    bool score_worker = dim < HEAD_WIDTH;
    bool controller = dim == HEAD_WIDTH;
    uint score_subgroup_count = HEAD_WIDTH / gl_SubgroupSize;
    uint stream_tick = stream_control.words[1];
    uint local_capacity = min(stream_control.words[4], LOCAL_WINDOW);
    uint local_tokens = local_capacity == 0u
        ? 0u
        : min(stream_tick + 1u, local_capacity);
    uint oldest_tick = stream_tick + 1u - local_tokens;
    uint compressed_count = min(
        (stream_tick + 1u) / COMPRESSION_RATIO,
        MAX_COMPRESSED_INDICES
    );
    uint total_tokens = local_tokens + compressed_count;
    float query_value = score_worker ? read_query(query_head, dim) : 0.0;
    float accumulator = 0.0;

    if (controller) {
        running_maximum = uintBitsToFloat(attention_sinks.words[query_head]);
        running_denominator = 1.0;
    }
    barrier();

    for (uint tile_start = 0u; tile_start < total_tokens; tile_start += TILE_TOKENS) {
        uint tile_count = min(TILE_TOKENS, total_tokens - tile_start);
        if (score_worker) {
            produce_score_partials(
                0u,
                tile_start,
                query_value,
                dim,
                local_tokens,
                compressed_count,
                oldest_tick,
                local_capacity
            );
        }
        barrier();

        for (uint tile_token = 0u; tile_token < tile_count; ++tile_token) {
            uint current_buffer = tile_token & 1u;
            if (controller) {
                float score = 0.0;
                for (uint subgroup = 0u;
                     subgroup < score_subgroup_count;
                     ++subgroup) {
                    score += score_partials[
                        current_buffer * MAX_SCORE_SUBGROUP_COUNT + subgroup
                    ];
                }
                uint token = tile_start + tile_token;
                tile_scores[tile_token] = token_valid(
                    token,
                    local_tokens,
                    compressed_count
                ) ? score * ATTENTION_SCALE : LOWEST_FLOAT;
            }
            if (score_worker && tile_token + 1u < tile_count) {
                produce_score_partials(
                    current_buffer ^ 1u,
                    tile_start + tile_token + 1u,
                    query_value,
                    dim,
                    local_tokens,
                    compressed_count,
                    oldest_tick,
                    local_capacity
                );
            }
            barrier();
        }

        if (controller) {
            float tile_maximum = LOWEST_FLOAT;
            for (uint tile_token = 0u; tile_token < tile_count; ++tile_token) {
                tile_maximum = max(tile_maximum, tile_scores[tile_token]);
            }
            float next_maximum = max(running_maximum, tile_maximum);
            float old_scale = exp(running_maximum - next_maximum);
            float tile_denominator = 0.0;
            for (uint tile_token = 0u; tile_token < tile_count; ++tile_token) {
                float weight = exp(tile_scores[tile_token] - next_maximum);
                tile_weights[tile_token] = weight;
                tile_denominator += weight;
            }
            running_denominator =
                running_denominator * old_scale + tile_denominator;
            running_maximum = next_maximum;
            previous_accumulator_scale = old_scale;
        }
        barrier();

        if (score_worker) {
            float tile_accumulator = 0.0;
            for (uint tile_token = 0u; tile_token < tile_count; ++tile_token) {
                uint token = tile_start + tile_token;
                if (token_valid(token, local_tokens, compressed_count)) {
                    tile_accumulator += tile_weights[tile_token] * read_token_value(
                        token,
                        dim,
                        local_tokens,
                        oldest_tick,
                        local_capacity
                    );
                }
            }
            accumulator =
                accumulator * previous_accumulator_scale + tile_accumulator;
        }
        barrier();
    }

    if (score_worker) {
        output_values[dim] = accumulator / running_denominator;
    }
    barrier();
    if (dim < HEAD_WIDTH && (dim & 1u) == 0u) {
        uint element = query_head * HEAD_WIDTH + dim;
        output_frame.words[element >> 1u] =
            f32_to_bf16(output_values[dim])
            | (f32_to_bf16(output_values[dim + 1u]) << 16u);
    }
}
