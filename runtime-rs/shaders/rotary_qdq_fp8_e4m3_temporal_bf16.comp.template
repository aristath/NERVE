#version 460

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_float_e4m3 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputFrames {
    uint words[];
} input_frames;

layout(set = 0, binding = 1) buffer OutputFrames {
    uint words[];
} output_frames;

layout(set = 0, binding = {{BATCH_CONTROL_BINDING}}) readonly buffer BatchControl {
    uint batch_width;
    uint start_stream_tick_low;
    uint start_stream_tick_high;
    uint dynamic_state_capacity;
} batch_control;

const uint HEAD_COUNT = {{HEAD_COUNT}}u;
const uint HEAD_WIDTH = {{HEAD_WIDTH}}u;
const uint ROTARY_WIDTH = {{ROTARY_WIDTH}}u;
const uint NON_ROTARY_WIDTH = HEAD_WIDTH - ROTARY_WIDTH;
const uint ROTARY_OFFSET = NON_ROTARY_WIDTH;
const uint QUANT_BLOCK_COLUMNS = {{QUANT_BLOCK_COLUMNS}}u;
const uint QUANT_BLOCK_COUNT = NON_ROTARY_WIDTH / QUANT_BLOCK_COLUMNS;
const uint FRAME_WIDTH = HEAD_COUNT * HEAD_WIDTH;
const uint FRAME_WORDS = (FRAME_WIDTH + 1u) / 2u;
const float ROPE_THETA = {{ROPE_THETA}};
const bool ROPE_INTERLEAVED = {{ROPE_INTERLEAVED}};
const bool ROPE_YARN = {{ROPE_YARN}};
const float ROPE_FACTOR = {{ROPE_FACTOR}};
const float ROPE_CORRECTION_LOW = {{ROPE_CORRECTION_LOW}};
const float ROPE_CORRECTION_HIGH = {{ROPE_CORRECTION_HIGH}};
const float ROPE_ATTENTION_FACTOR = {{ROPE_ATTENTION_FACTOR}};
const int POSITION_OFFSET = {{POSITION_OFFSET}};

shared float input_values[HEAD_WIDTH];
shared float output_values[HEAD_WIDTH];
shared float block_scales[QUANT_BLOCK_COUNT];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16u);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7fffu + lsb) >> 16u;
}

float round_bf16(float value) {
    return bf16_to_f32(f32_to_bf16(value));
}

float read_input(uint position, uint index) {
    uint packed = input_frames.words[position * FRAME_WORDS + (index >> 1u)];
    uint value = ((index & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16u);
    return bf16_to_f32(value);
}

float rope_inverse_frequency(uint frequency_index) {
    float inverse_frequency = pow(
        ROPE_THETA,
        -2.0 * float(frequency_index) / float(ROTARY_WIDTH)
    );
    if (!ROPE_YARN) return inverse_frequency;
    float ramp = clamp(
        (float(frequency_index) - ROPE_CORRECTION_LOW)
            / (ROPE_CORRECTION_HIGH - ROPE_CORRECTION_LOW),
        0.0,
        1.0
    );
    return mix(inverse_frequency, inverse_frequency / ROPE_FACTOR, ramp);
}

float rotate_value(uint dim) {
    uint rotary_dim = dim - ROTARY_OFFSET;
    if (ROPE_INTERLEAVED) {
        return (rotary_dim & 1u) == 0u
            ? -input_values[ROTARY_OFFSET + rotary_dim + 1u]
            : input_values[ROTARY_OFFSET + rotary_dim - 1u];
    }
    return rotary_dim < (ROTARY_WIDTH / 2u)
        ? -input_values[ROTARY_OFFSET + rotary_dim + (ROTARY_WIDTH / 2u)]
        : input_values[ROTARY_OFFSET + rotary_dim - (ROTARY_WIDTH / 2u)];
}

float rotate(uint dim, uint position) {
    if (dim < ROTARY_OFFSET) return input_values[dim];
    uint rotary_dim = dim - ROTARY_OFFSET;
    uint frequency_index = ROPE_INTERLEAVED
        ? rotary_dim / 2u
        : rotary_dim % (ROTARY_WIDTH / 2u);
    float angle = (
        float(batch_control.start_stream_tick_low + position)
        + float(POSITION_OFFSET)
    ) * rope_inverse_frequency(frequency_index);
    float cosine = round_bf16(cos(angle) * ROPE_ATTENTION_FACTOR);
    float sine = round_bf16(sin(angle) * ROPE_ATTENTION_FACTOR);
    float direct = round_bf16(input_values[dim] * cosine);
    float rotated = round_bf16(rotate_value(dim) * sine);
    return round_bf16(direct + rotated);
}

float quantize_dequantize_e4m3(float value, float scale) {
    fe4m3vec4 quantized = fe4m3vec4(vec4(clamp(value / scale, -448.0, 448.0)));
    u8vec4 bits = floate4m3BitsToUintEXT(quantized);
    vec4 restored = vec4(uintBitsToFloate4m3EXT(bits));
    return restored.x * scale;
}

void main() {
    uint head = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (head >= HEAD_COUNT) return;
    uint base = head * HEAD_WIDTH;

    for (uint position = 0u; position < batch_control.batch_width; ++position) {
        for (uint dim = lane; dim < HEAD_WIDTH; dim += 64u) {
            input_values[dim] = read_input(position, base + dim);
        }
        barrier();
        for (uint dim = lane; dim < HEAD_WIDTH; dim += 64u) {
            output_values[dim] = rotate(dim, position);
        }
        barrier();

        for (uint block = lane; block < QUANT_BLOCK_COUNT; block += 64u) {
            float maximum = 0.0;
            uint begin = block * QUANT_BLOCK_COLUMNS;
            for (uint offset = 0u; offset < QUANT_BLOCK_COLUMNS; ++offset) {
                maximum = max(maximum, abs(output_values[begin + offset]));
            }
            block_scales[block] = {{DYNAMIC_SCALE}};
        }
        barrier();
        for (uint dim = lane; dim < NON_ROTARY_WIDTH; dim += 64u) {
            float scale = block_scales[dim / QUANT_BLOCK_COLUMNS];
            output_values[dim] = round_bf16(
                quantize_dequantize_e4m3(output_values[dim], scale)
            );
        }
        barrier();

        for (uint dim = lane * 2u; dim < HEAD_WIDTH; dim += 128u) {
            float lo = output_values[dim];
            float hi = output_values[dim + 1u];
            uint word_index = position * FRAME_WORDS + ((base + dim) >> 1u);
            output_frames.words[word_index] =
                (f32_to_bf16(hi) << 16u) | f32_to_bf16(lo);
        }
        barrier();
    }
}
