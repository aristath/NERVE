#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_EXT_buffer_reference2 : require

spirv_instruction(
    extensions = ["SPV_VALVE_mixed_float_dot_product"],
    capabilities = [6915],
    id = 6918
)
float fp8_dot4_acc32(fe4m3vec4 a, fe4m3vec4 b, float accumulator);

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

#define PREEXPANDED_FP8 {{PREEXPANDED_FP8}}
#define DYNAMIC_WEIGHT_REPRESENTATION {{DYNAMIC_WEIGHT_REPRESENTATION}}
#define INPUT_BLOCK_MAJOR {{INPUT_BLOCK_MAJOR}}

layout(set = 0, binding = 0) readonly buffer ExpertIntermediates { uint words[]; } expert_intermediates;
layout(set = 0, binding = 1) readonly buffer ExpertRoutes { uint words[]; } expert_routes;
layout(set = 0, binding = 2) buffer ExpertOutputs { uint words[]; } expert_outputs;
layout(set = 0, binding = 3) readonly buffer DynamicResourceAddresses { uint words[]; } dynamic_resource_addresses;
layout(set = 0, binding = 4) readonly buffer DynamicParameterSlots { uint words[]; } dynamic_parameter_slots;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer DynamicU32Buffer {
    uint words[];
};

layout(push_constant) uniform BatchControl {
    uint batch_width;
    uint expert_start;
    uint expert_count;
    uint owned_route_count;
    uint dispatch_x;
    uint dispatch_y;
    uint dispatch_z;
} batch_control;

const uint HIDDEN_SIZE = {{HIDDEN_SIZE}}u;
const uint INTERMEDIATE_SIZE = {{INTERMEDIATE_SIZE}}u;
const uint NUM_EXPERTS = {{NUM_EXPERTS}}u;
const uint NATIVE_FP8_RESOURCE_START = {{NATIVE_FP8_RESOURCE_START}}u;
const uint EXPERTS_PER_TOKEN = {{EXPERTS_PER_TOKEN}}u;
const uint TILE_ROWS = {{TILE_ROWS}}u;
const uint TILES_PER_ROUTE = (HIDDEN_SIZE + TILE_ROWS - 1u) / TILE_ROWS;
const uint HIDDEN_WORDS = HIDDEN_SIZE / 2u;
const uint INTERMEDIATE_WORDS = INTERMEDIATE_SIZE / 2u;
const uint INTERMEDIATE_FP8_WORDS = INTERMEDIATE_SIZE / 4u;
const uint INTERMEDIATE_BLOCKS = INTERMEDIATE_SIZE / 128u;
const uint EXPERT_DATA_WORDS = EXPERTS_PER_TOKEN * INTERMEDIATE_WORDS;
const uint EXPERT_FRAME_WORDS = EXPERT_DATA_WORDS + EXPERTS_PER_TOKEN;
const uint COMPACT_WEIGHT_ROW_BYTES = INTERMEDIATE_SIZE / 2u;
const uint EXPANDED_WEIGHT_ROW_BYTES = INTERMEDIATE_SIZE;
const uint SCALE_ROW_BYTES = INTERMEDIATE_SIZE / 32u;
const uint NATIVE_FP8_SCALE_COLUMNS = (INTERMEDIATE_SIZE + 127u) / 128u;
const uint NATIVE_FP8_SCALE_BYTES =
    ((HIDDEN_SIZE + 127u) / 128u) * NATIVE_FP8_SCALE_COLUMNS;
const uint ADDRESS_RECORD_WORDS = 8u;
const uint DYNAMIC_PARAMETER_COUNT = 2u;
const uint UNBOUND_PARAMETER_SLOT = 0xffffffffu;
const uint MXFP4_E4M3_BITS[8] = uint[8](
    0x00u, 0x30u, 0x38u, 0x3cu, 0x40u, 0x44u, 0x48u, 0x4cu
);

shared fe4m3vec4 quantized_intermediate[INTERMEDIATE_FP8_WORDS];
shared float intermediate_scales[INTERMEDIATE_BLOCKS];
shared float output_rows[TILE_ROWS];

float bf16_to_f32(uint value) { return uintBitsToFloat((value & 0xffffu) << 16); }

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7fffu + lsb) >> 16;
}

float round_bf16(float value) { return bf16_to_f32(f32_to_bf16(value)); }

uint dynamic_parameter_slot(uint expert, uint parameter) {
    return dynamic_parameter_slots.words[
        expert * DYNAMIC_PARAMETER_COUNT + parameter
    ];
}

uint address_table_slot_count() {
    return dynamic_resource_addresses.words.length() / ADDRESS_RECORD_WORDS;
}

uint64_t address_record_byte_count(uint record) {
    return uint64_t(dynamic_resource_addresses.words[record + 2u])
        | (uint64_t(dynamic_resource_addresses.words[record + 3u]) << 32u);
}

bool address_record_is_resident(uint record, uint64_t required_byte_count) {
    uint64_t address = uint64_t(dynamic_resource_addresses.words[record])
        | (uint64_t(dynamic_resource_addresses.words[record + 1u]) << 32u);
    uint generation_nonzero = dynamic_resource_addresses.words[record + 4u]
        | dynamic_resource_addresses.words[record + 5u];
    return address != uint64_t(0)
        && (address & uint64_t(3)) == uint64_t(0)
        && address_record_byte_count(record) >= required_byte_count
        && generation_nonzero != 0u
        && dynamic_resource_addresses.words[record + 6u] == 1u;
}

bool dynamic_parameter_record_is_valid(
    uint expert,
    uint parameter,
    uint64_t required_byte_count
) {
    uint parameter_index = expert * DYNAMIC_PARAMETER_COUNT + parameter;
    if (parameter_index >= dynamic_parameter_slots.words.length()) return false;
    uint slot = dynamic_parameter_slots.words[parameter_index];
    if (slot == UNBOUND_PARAMETER_SLOT || slot >= address_table_slot_count()) return false;
    return address_record_is_resident(slot * ADDRESS_RECORD_WORDS, required_byte_count);
}

uint dynamic_parameter_representation(uint expert, uint parameter) {
    uint parameter_index = expert * DYNAMIC_PARAMETER_COUNT + parameter;
    if (parameter_index >= dynamic_parameter_slots.words.length()) return 0u;
    uint slot = dynamic_parameter_slots.words[parameter_index];
    if (slot == UNBOUND_PARAMETER_SLOT || slot >= address_table_slot_count()) return 0u;
    uint record = slot * ADDRESS_RECORD_WORDS;
    return dynamic_resource_addresses.words[record + 7u];
}

bool dynamic_weight_representation_is_valid(uint expert, uint parameter) {
#if DYNAMIC_WEIGHT_REPRESENTATION
    return dynamic_parameter_representation(expert, parameter) <= 1u;
#else
    return true;
#endif
}

bool dynamic_weight_is_preexpanded(uint expert, uint parameter) {
    if (expert >= NATIVE_FP8_RESOURCE_START) return false;
#if PREEXPANDED_FP8
    return true;
#elif DYNAMIC_WEIGHT_REPRESENTATION
    return dynamic_parameter_representation(expert, parameter) == 1u;
#else
    return false;
#endif
}

bool expert_uses_native_fp8(uint expert) {
    return expert >= NATIVE_FP8_RESOURCE_START;
}

bool dynamic_expert_is_valid(uint expert) {
    bool native_fp8 = expert_uses_native_fp8(expert);
    bool down_preexpanded = dynamic_weight_is_preexpanded(expert, 0u);
    uint64_t weight_bytes = native_fp8
        ? uint64_t(HIDDEN_SIZE) * uint64_t(EXPANDED_WEIGHT_ROW_BYTES)
        : uint64_t(HIDDEN_SIZE) * uint64_t(
            down_preexpanded ? EXPANDED_WEIGHT_ROW_BYTES : COMPACT_WEIGHT_ROW_BYTES
        );
    uint64_t scale_bytes = native_fp8
        ? uint64_t(NATIVE_FP8_SCALE_BYTES)
        : uint64_t(HIDDEN_SIZE) * uint64_t(SCALE_ROW_BYTES);
    return (!native_fp8 || dynamic_parameter_representation(expert, 0u) == 0u)
        && (native_fp8 || dynamic_weight_representation_is_valid(expert, 0u))
        && dynamic_parameter_record_is_valid(expert, 0u, weight_bytes)
        && dynamic_parameter_record_is_valid(expert, 1u, scale_bytes);
}

DynamicU32Buffer dynamic_parameter(uint expert, uint parameter) {
    uint record = dynamic_parameter_slot(expert, parameter) * ADDRESS_RECORD_WORDS;
    uint64_t address = uint64_t(dynamic_resource_addresses.words[record])
        | (uint64_t(dynamic_resource_addresses.words[record + 1u]) << 32u);
    return DynamicU32Buffer(address);
}

uint read_u8(DynamicU32Buffer source, uint index) {
    return (source.words[index >> 2u] >> ((index & 3u) * 8u)) & 0xffu;
}

uint mxfp4_e4m3_bits(uint nibble) {
    return MXFP4_E4M3_BITS[nibble & 7u] | ((nibble & 8u) << 4u);
}

fe4m3vec4 read_expanded_fp8x4(
    DynamicU32Buffer weight,
    uint row,
    uint column
) {
#if INPUT_BLOCK_MAJOR
    uint block = column / 128u;
    uint block_column = column % 128u;
    uint byte_index = (block * HIDDEN_SIZE + row) * 128u + block_column;
    uint packed = weight.words[byte_index >> 2u];
#else
    uint packed = weight.words[(row * EXPANDED_WEIGHT_ROW_BYTES + column) >> 2u];
#endif
    return uintBitsToFloate4m3EXT(u8vec4(
        uint8_t(packed),
        uint8_t(packed >> 8u),
        uint8_t(packed >> 16u),
        uint8_t(packed >> 24u)
    ));
}

fe4m3vec4 read_compact_mxfp4x4(
    DynamicU32Buffer weight,
    uint row,
    uint column
) {
#if INPUT_BLOCK_MAJOR
    uint block = column / 128u;
    uint block_column = column % 128u;
    uint byte_index = (block * HIDDEN_SIZE + row) * 64u + block_column / 2u;
#else
    uint byte_index = row * COMPACT_WEIGHT_ROW_BYTES + column / 2u;
#endif
    uint lo = read_u8(weight, byte_index);
    uint hi = read_u8(weight, byte_index + 1u);
    return uintBitsToFloate4m3EXT(u8vec4(
        uint8_t(mxfp4_e4m3_bits(lo & 0x0fu)),
        uint8_t(mxfp4_e4m3_bits(lo >> 4u)),
        uint8_t(mxfp4_e4m3_bits(hi & 0x0fu)),
        uint8_t(mxfp4_e4m3_bits(hi >> 4u))
    ));
}

fe4m3vec4 read_mxfp4x4(
    DynamicU32Buffer weight,
    uint row,
    uint column,
    bool preexpanded
) {
#if PREEXPANDED_FP8
    return read_expanded_fp8x4(weight, row, column);
#else
    return read_compact_mxfp4x4(weight, row, column);
#endif
}

float read_e8m0_scale(DynamicU32Buffer scale, uint row, uint block) {
#if INPUT_BLOCK_MAJOR
    uint scale_byte = read_u8(
        scale,
        (block / 4u * HIDDEN_SIZE + row) * 4u + block % 4u
    );
#else
    uint scale_byte = read_u8(scale, row * SCALE_ROW_BYTES + block);
#endif
    if (scale_byte == 0u) return uintBitsToFloat(0x00400000u);
    return uintBitsToFloat(scale_byte << 23u);
}

float read_native_fp8_scale(
    DynamicU32Buffer scale,
    uint row,
    uint column
) {
    uint index = (row / 128u) * NATIVE_FP8_SCALE_COLUMNS + column / 128u;
    return uintBitsToFloat(read_u8(scale, index) << 23u);
}

void accumulate_down_native_fp8(
    DynamicU32Buffer down_weight,
    DynamicU32Buffer down_scale,
    uint row,
    inout float value
) {
    for (
        uint word = gl_SubgroupInvocationID;
        word < INTERMEDIATE_FP8_WORDS;
        word += gl_SubgroupSize
    ) {
        uint column = word * 4u;
        uint activation_block = column / 128u;
        value = fma(
            fp8_dot4_acc32(
                quantized_intermediate[word],
                read_expanded_fp8x4(down_weight, row, column),
                0.0
            ),
            intermediate_scales[activation_block]
                * read_native_fp8_scale(down_scale, row, column),
            value
        );
    }
}

float rounded_fp8_scale(float block_max) {
    float ratio = max(block_max, 1e-4) / 448.0;
    uint bits = floatBitsToUint(ratio);
    int exponent = int((bits >> 23u) & 0xffu) - 127;
    if ((bits & 0x7fffffu) != 0u) exponent++;
    return uintBitsToFloat(uint(exponent + 127) << 23u);
}

vec4 read_intermediatex4(uint batch_index, uint route, uint column) {
    uint offset = batch_index * EXPERT_FRAME_WORDS
        + route * INTERMEDIATE_WORDS + column / 2u;
    uint lo = expert_intermediates.words[offset];
    uint hi = expert_intermediates.words[offset + 1u];
    return vec4(
        bf16_to_f32(lo), bf16_to_f32(lo >> 16u),
        bf16_to_f32(hi), bf16_to_f32(hi >> 16u)
    );
}

void quantize_intermediate(uint lane, uint batch_index, uint route) {
    if (lane >= 64u) return;
    uint cluster = lane >> 5u;
    uint cluster_lane = lane & 31u;
    for (uint block = cluster; block < INTERMEDIATE_BLOCKS; block += 2u) {
        uint word = block * 32u + cluster_lane;
        vec4 value = read_intermediatex4(batch_index, route, word * 4u);
        float lane_max = max(
            max(abs(value.x), abs(value.y)),
            max(abs(value.z), abs(value.w))
        );
        float block_max = subgroupClusteredMax(lane_max, 32u);
        float scale = rounded_fp8_scale(block_max);
        if (cluster_lane == 0u) intermediate_scales[block] = scale;
        quantized_intermediate[word] = fe4m3vec4(value / scale);
    }
}

#if DYNAMIC_WEIGHT_REPRESENTATION
void accumulate_down_compact(
    DynamicU32Buffer down_weight,
    DynamicU32Buffer down_scale,
    uint row,
    inout float value
) {
    for (
        uint word = gl_SubgroupInvocationID;
        word < INTERMEDIATE_FP8_WORDS;
        word += gl_SubgroupSize
    ) {
        uint column = word * 4u;
        uint activation_block = column / 128u;
        uint weight_block = column / 32u;
        value = fma(
            fp8_dot4_acc32(
                quantized_intermediate[word],
                read_compact_mxfp4x4(down_weight, row, column),
                0.0
            ),
            intermediate_scales[activation_block]
                * read_e8m0_scale(down_scale, row, weight_block),
            value
        );
    }
}

void accumulate_down_expanded(
    DynamicU32Buffer down_weight,
    DynamicU32Buffer down_scale,
    uint row,
    inout float value
) {
    for (
        uint word = gl_SubgroupInvocationID;
        word < INTERMEDIATE_FP8_WORDS;
        word += gl_SubgroupSize
    ) {
        uint column = word * 4u;
        uint activation_block = column / 128u;
        uint weight_block = column / 32u;
        value = fma(
            fp8_dot4_acc32(
                quantized_intermediate[word],
                read_expanded_fp8x4(down_weight, row, column),
                0.0
            ),
            intermediate_scales[activation_block]
                * read_e8m0_scale(down_scale, row, weight_block),
            value
        );
    }
}
#endif

void main() {
    uint group = gl_WorkGroupID.x;
    uint linear_route = group / TILES_PER_ROUTE;
    bool route_native = batch_control.expert_count != 0u;
    uint compact_batch = route_native
        ? linear_route / EXPERTS_PER_TOKEN
        : gl_WorkGroupID.y;
    uint compact_route = route_native
        ? linear_route % EXPERTS_PER_TOKEN
        : linear_route;
    uint tile = group % TILES_PER_ROUTE;
    if (
        (route_native && linear_route >= batch_control.owned_route_count)
        || (!route_native && compact_batch >= batch_control.batch_width)
        || (!route_native && compact_route >= EXPERTS_PER_TOKEN)
    ) return;
    uint route_index = expert_intermediates.words[
        compact_batch * EXPERT_FRAME_WORDS + EXPERT_DATA_WORDS + compact_route
    ];
    uint route_capacity = batch_control.batch_width * EXPERTS_PER_TOKEN;
    if (route_index >= route_capacity) return;
    uint batch_index = route_index / EXPERTS_PER_TOKEN;
    uint route = route_index % EXPERTS_PER_TOKEN;
    uint packed_route = expert_routes.words[
        batch_index * EXPERTS_PER_TOKEN + route
    ];
    uint expert = packed_route & 0xffffu;
    if (expert >= NUM_EXPERTS || !dynamic_expert_is_valid(expert)) return;
    DynamicU32Buffer down_weight = dynamic_parameter(expert, 0u);
    DynamicU32Buffer down_scale = dynamic_parameter(expert, 1u);
    bool down_preexpanded = dynamic_weight_is_preexpanded(expert, 0u);
    bool native_fp8 = expert_uses_native_fp8(expert);
    float route_weight = bf16_to_f32(packed_route >> 16u);

    uint lane = gl_LocalInvocationID.x;
    quantize_intermediate(lane, batch_index, route);
    barrier();
    uint first_row = tile * TILE_ROWS;
    for (
        uint local_row = gl_SubgroupID;
        local_row < TILE_ROWS;
        local_row += gl_NumSubgroups
    ) {
        uint row = first_row + local_row;
        float value = 0.0;
        if (row < HIDDEN_SIZE) {
            if (native_fp8) {
                accumulate_down_native_fp8(down_weight, down_scale, row, value);
            } else {
#if DYNAMIC_WEIGHT_REPRESENTATION
                if (down_preexpanded) {
                    accumulate_down_expanded(down_weight, down_scale, row, value);
                } else {
                    accumulate_down_compact(down_weight, down_scale, row, value);
                }
#else
                for (
                    uint word = gl_SubgroupInvocationID;
                    word < INTERMEDIATE_FP8_WORDS;
                    word += gl_SubgroupSize
                ) {
                    uint column = word * 4u;
                    uint activation_block = column / 128u;
                    uint weight_block = column / 32u;
                    value = fma(
                        fp8_dot4_acc32(
                            quantized_intermediate[word],
                            read_mxfp4x4(
                                down_weight,
                                row,
                                column,
                                down_preexpanded
                            ),
                            0.0
                        ),
                        intermediate_scales[activation_block]
                            * read_e8m0_scale(down_scale, row, weight_block),
                        value
                    );
                }
#endif
            }
        }
        value = subgroupAdd(value);
        if (gl_SubgroupInvocationID == 0u) {
            output_rows[local_row] = row < HIDDEN_SIZE
                ? round_bf16(round_bf16(value) * route_weight)
                : 0.0;
        }
    }
    barrier();
    if (lane < TILE_ROWS / 2u) {
        uint row = first_row + lane * 2u;
        if (row < HIDDEN_SIZE) {
            uint high = row + 1u < HIDDEN_SIZE
                ? f32_to_bf16(output_rows[lane * 2u + 1u])
                : 0u;
            uint output_offset =
                batch_index * EXPERTS_PER_TOKEN * HIDDEN_WORDS;
            expert_outputs.words[output_offset + route * HIDDEN_WORDS + row / 2u] =
                (high << 16u) | f32_to_bf16(output_rows[lane * 2u]);
        }
    }
}
