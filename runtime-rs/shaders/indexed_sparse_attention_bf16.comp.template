#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = {{LOCAL_SIZE}}, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QueryFrames {
    uint words[];
} query_frames;
layout(set = 0, binding = 1) readonly buffer LocalStateView {
    uint words[];
} local_state;
layout(set = 0, binding = 2) readonly buffer QueryKeyValueFrames {
    uint words[];
} query_key_value_frames;
layout(set = 0, binding = 3) buffer OutputFrames {
    uint words[];
} output_frames;
layout(set = 0, binding = 4) readonly buffer AttentionSinks {
    uint words[];
} attention_sinks;

#if {{PARALLEL_BLOCK}}
layout(set = 0, binding = 6) readonly buffer BatchControl {
    uint batch_width;
    uint start_stream_tick_low;
    uint start_stream_tick_high;
    uint dynamic_state_capacity;
} batch_control;
#else
layout(set = 0, binding = 6) readonly buffer StreamControl {
    uint words[];
} stream_control;
#endif

const uint QUERY_HEADS = {{QUERY_HEADS}}u;
const uint KV_HEADS = {{KV_HEADS}}u;
const uint QUERY_GROUPS_PER_KV_HEAD = QUERY_HEADS / KV_HEADS;
const uint HEAD_WIDTH = {{HEAD_WIDTH}}u;
const uint HEAD_WORDS = HEAD_WIDTH / 2u;
const uint QUERY_WORDS = QUERY_HEADS * HEAD_WORDS;
const uint LOCAL_WINDOW = {{LOCAL_WINDOW}}u;
const uint MAX_PARALLEL_BLOCK = 64u;
const uint MAX_ATTENDED_TOKENS = LOCAL_WINDOW + MAX_PARALLEL_BLOCK;
const uint SUBGROUP_COUNT = HEAD_WIDTH / 32u;
const uint STATE_PAGE_TABLE_WORDS = 9u;
const float ATTENTION_SCALE = {{ATTENTION_SCALE}};
const float LOWEST_FLOAT = -3.4028234663852886e38;

shared float score_partials[MAX_ATTENDED_TOKENS * SUBGROUP_COUNT];
shared float attention_scores[MAX_ATTENDED_TOKENS];
shared float softmax_denominator;
shared float output_values[HEAD_WIDTH];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16u);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7fffu + lsb) >> 16u;
}

float read_bf16(uint packed, uint element_index) {
    return bf16_to_f32(packed >> ((element_index & 1u) * 16u));
}

uint active_block_width() {
#if {{PARALLEL_BLOCK}}
    return batch_control.batch_width;
#else
    return 1u;
#endif
}

uint committed_stream_tick() {
#if {{PARALLEL_BLOCK}}
    return batch_control.start_stream_tick_low;
#else
    return stream_control.words[1];
#endif
}

uint dynamic_state_capacity() {
#if {{PARALLEL_BLOCK}}
    return batch_control.dynamic_state_capacity;
#else
    return stream_control.words[4];
#endif
}

uint query_position() {
#if {{PARALLEL_BLOCK}}
    return gl_WorkGroupID.y;
#else
    return 0u;
#endif
}

uint local_state_word(uint logical_word) {
    uint logical_byte = logical_word * 4u;
    if (logical_byte < local_state.words[2]) {
        return (local_state.words[3] + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - local_state.words[2];
    uint page_bytes = local_state.words[4];
    uint physical_page = local_state.words[
        STATE_PAGE_TABLE_WORDS + dynamic_byte / page_bytes
    ];
    return (
        local_state.words[8]
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}

float read_query(uint position, uint head, uint dim) {
    uint element = position * QUERY_HEADS * HEAD_WIDTH + head * HEAD_WIDTH + dim;
    return read_bf16(query_frames.words[element >> 1u], element);
}

float read_local_key_value(uint absolute_tick, uint capacity, uint dim) {
    uint slot = absolute_tick % capacity;
    uint element = slot * HEAD_WIDTH + dim;
    uint packed = local_state.words[local_state_word(element >> 1u)];
    return read_bf16(packed, element);
}

float read_query_key_value(uint block_position, uint dim) {
    uint element = block_position * HEAD_WIDTH + dim;
    return read_bf16(query_key_value_frames.words[element >> 1u], element);
}

void main() {
    uint query_head = gl_WorkGroupID.x;
    uint position = query_position();
    uint block_width = active_block_width();
    uint dim = gl_LocalInvocationID.x;
    if (
        query_head >= QUERY_HEADS
        || position >= block_width
        || block_width == 0u
        || block_width > MAX_PARALLEL_BLOCK
    ) {
        return;
    }

    uint capacity = min(dynamic_state_capacity(), LOCAL_WINDOW);
    uint stream_tick = committed_stream_tick();
    uint local_tokens = capacity == 0u ? 0u : min(stream_tick + 1u, capacity);
    uint oldest_tick = stream_tick + 1u - local_tokens;
    uint total_tokens = local_tokens + block_width;
    float query_value = read_query(position, query_head, dim);

    for (uint token = 0u; token < total_tokens; token++) {
        float key_value = token < local_tokens
            ? read_local_key_value(oldest_tick + token, capacity, dim)
            : read_query_key_value(token - local_tokens, dim);
        float subgroup_partial = subgroupAdd(query_value * key_value);
        if (subgroupElect()) {
            score_partials[token * SUBGROUP_COUNT + gl_SubgroupID] =
                subgroup_partial;
        }
        barrier();
        if (dim == 0u) {
            float score = 0.0;
            for (uint subgroup = 0u; subgroup < SUBGROUP_COUNT; subgroup++) {
                score += score_partials[token * SUBGROUP_COUNT + subgroup];
            }
            attention_scores[token] = score * ATTENTION_SCALE;
        }
        barrier();
    }

    if (dim == 0u) {
        float maximum = uintBitsToFloat(attention_sinks.words[query_head]);
        for (uint token = 0u; token < total_tokens; token++) {
            maximum = max(maximum, attention_scores[token]);
        }
        float denominator = exp(
            uintBitsToFloat(attention_sinks.words[query_head]) - maximum
        );
        for (uint token = 0u; token < total_tokens; token++) {
            float weight = exp(attention_scores[token] - maximum);
            attention_scores[token] = weight;
            denominator += weight;
        }
        softmax_denominator = denominator;
    }
    barrier();

    float output_value = 0.0;
    for (uint token = 0u; token < total_tokens; token++) {
        float value = token < local_tokens
            ? read_local_key_value(oldest_tick + token, capacity, dim)
            : read_query_key_value(token - local_tokens, dim);
        output_value += attention_scores[token] * value;
    }
    output_value /= softmax_denominator;
    output_values[dim] = output_value;
    barrier();

    if ((dim & 1u) == 0u) {
        uint output_element =
            position * QUERY_HEADS * HEAD_WIDTH + query_head * HEAD_WIDTH + dim;
        output_frames.words[output_element >> 1u] =
            f32_to_bf16(output_values[dim])
            | (f32_to_bf16(output_values[dim + 1u]) << 16u);
    }
}
