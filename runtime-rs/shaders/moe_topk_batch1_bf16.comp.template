#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer RouterLogits { uint words[]; } router_logits;
layout(set = 0, binding = 1) buffer ExpertRoutes { uint words[]; } expert_routes;
layout(set = 0, binding = 2) buffer SelectionTelemetry { uint counts[]; } selection_telemetry;

layout(push_constant) uniform BatchControl { uint batch_width; } batch_control;

const uint NUM_EXPERTS = {{NUM_EXPERTS}}u;
const uint EXPERTS_PER_TOKEN = {{EXPERTS_PER_TOKEN}}u;
const uint ROUTER_WORDS = (NUM_EXPERTS + 1u) / 2u;

shared uint top_indices[EXPERTS_PER_TOKEN];
shared float top_scores[EXPERTS_PER_TOKEN];
shared float router_scores[NUM_EXPERTS];
shared float subgroup_best_scores[64];
shared uint subgroup_best_experts[64];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7fffu + lsb) >> 16;
}

float read_router(uint batch_index, uint index) {
    uint packed = router_logits.words[batch_index * ROUTER_WORDS + (index >> 1u)];
    return bf16_to_f32((index & 1u) == 0u ? packed : packed >> 16u);
}

void main() {
    uint batch_index = gl_WorkGroupID.y;
    if (batch_index >= batch_control.batch_width) {
        return;
    }
    uint lane = gl_LocalInvocationID.x;
    for (uint expert = lane; expert < NUM_EXPERTS; expert += gl_WorkGroupSize.x) {
        router_scores[expert] = read_router(batch_index, expert);
    }
    barrier();

    for (uint route = 0u; route < EXPERTS_PER_TOKEN; route++) {
        float best_score = -uintBitsToFloat(0x7f800000u);
        uint best_expert = 0xffffffffu;
        for (uint expert = lane; expert < NUM_EXPERTS; expert += gl_WorkGroupSize.x) {
            float score = router_scores[expert];
            if (
                score > best_score
                || (score == best_score && expert < best_expert)
            ) {
                best_score = score;
                best_expert = expert;
            }
        }
        float subgroup_score = subgroupMax(best_score);
        uint subgroup_expert = subgroupMin(
            best_score == subgroup_score ? best_expert : 0xffffffffu
        );
        if (gl_NumSubgroups == 1u) {
            if (lane == 0u) {
                top_indices[route] = subgroup_expert;
                top_scores[route] = subgroup_score;
                router_scores[subgroup_expert] =
                    -uintBitsToFloat(0x7f800000u);
            }
        } else {
            if (subgroupElect()) {
                subgroup_best_scores[gl_SubgroupID] = subgroup_score;
                subgroup_best_experts[gl_SubgroupID] = subgroup_expert;
            }
            barrier();
            if (lane == 0u) {
                float route_score = -uintBitsToFloat(0x7f800000u);
                uint route_expert = 0xffffffffu;
                for (uint subgroup = 0u; subgroup < gl_NumSubgroups; subgroup++) {
                    float score = subgroup_best_scores[subgroup];
                    uint expert = subgroup_best_experts[subgroup];
                    if (
                        score > route_score
                        || (score == route_score && expert < route_expert)
                    ) {
                        route_score = score;
                        route_expert = expert;
                    }
                }
                top_indices[route] = route_expert;
                top_scores[route] = route_score;
                router_scores[route_expert] =
                    -uintBitsToFloat(0x7f800000u);
            }
        }
        barrier();
    }

    if (lane == 0u) {
        float maximum = top_scores[0];
        float denominator = 0.0;
        for (uint route = 0u; route < EXPERTS_PER_TOKEN; route++) {
            denominator += exp(top_scores[route] - maximum);
        }
        for (uint route = 1u; route < EXPERTS_PER_TOKEN; route++) {
            uint expert = top_indices[route];
            float score = top_scores[route];
            uint insertion = route;
            while (insertion > 0u && top_indices[insertion - 1u] > expert) {
                top_indices[insertion] = top_indices[insertion - 1u];
                top_scores[insertion] = top_scores[insertion - 1u];
                insertion--;
            }
            top_indices[insertion] = expert;
            top_scores[insertion] = score;
        }
        for (uint route = 0u; route < EXPERTS_PER_TOKEN; route++) {
            uint expert = top_indices[route];
            uint weight = f32_to_bf16(
                exp(top_scores[route] - maximum) / denominator
            );
            expert_routes.words[batch_index * EXPERTS_PER_TOKEN + route] =
                (weight << 16u) | expert;
            atomicAdd(selection_telemetry.counts[expert], 1u);
        }
    }
}
