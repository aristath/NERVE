#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_spirv_intrinsics : require

spirv_instruction(
    extensions = ["SPV_VALVE_mixed_float_dot_product"],
    capabilities = [6915],
    id = 6918
)
float fp8_dot4_acc32(fe4m3vec4 a, fe4m3vec4 b, float accumulator);

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QuantizedInput {
    fe4m3vec4 values[];
} quantized_input;
layout(set = 0, binding = 1) readonly buffer InputScale {
    float values[];
} input_scale;
layout(set = 0, binding = 2) buffer OutputFrame {
    uint words[];
} output_frame;
layout(set = 0, binding = 3) readonly buffer GateUpWeight {
    fe4m3vec4 values[];
} gate_up_weight;
layout(set = 0, binding = 4) readonly buffer GateUpScaleInv {
    uint words[];
} gate_up_scale_inv;

const uint BLOCK_ROWS = {{BLOCK_ROWS}}u;
const uint BLOCK_COLUMNS = {{BLOCK_COLUMNS}}u;
const uint INPUT_SIZE = {{INPUT_SIZE}}u;
const uint OUTPUT_SIZE = {{OUTPUT_SIZE}}u;
const uint OUTPUT_TILE_ROWS = {{OUTPUT_TILE_ROWS}}u;
const uint INPUT_FP8_WORDS = INPUT_SIZE / 4u;
const uint BLOCK_FP8_WORDS = BLOCK_COLUMNS / 4u;
const uint SCALE_COLUMNS = INPUT_SIZE / BLOCK_COLUMNS;

shared float projection_rows[2][OUTPUT_TILE_ROWS];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16u);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7fffu + lsb) >> 16u;
}

float round_bf16(float value) {
    return bf16_to_f32(f32_to_bf16(value));
}

float rounded_silu(float value) {
    return round_bf16(value / (1.0 + exp(-value)));
}

float read_bf16_word(uint packed, uint index) {
    return bf16_to_f32(packed >> ((index & 1u) * 16u));
}

float read_weight_scale(uint source_row, uint block) {
    uint index = (source_row / BLOCK_ROWS) * SCALE_COLUMNS + block;
    return read_bf16_word(gate_up_scale_inv.words[index >> 1u], index);
}

void main() {
    uint projection = gl_SubgroupID / OUTPUT_TILE_ROWS;
    uint local_row = gl_SubgroupID % OUTPUT_TILE_ROWS;
    uint row = gl_WorkGroupID.x * OUTPUT_TILE_ROWS + local_row;
    uint source_row = projection * OUTPUT_SIZE + row;
    float sum = 0.0;
    if (projection < 2u && row < OUTPUT_SIZE) {
        for (
            uint word = gl_SubgroupInvocationID;
            word < INPUT_FP8_WORDS;
            word += gl_SubgroupSize
        ) {
            uint block = word / BLOCK_FP8_WORDS;
            sum = fma(
                fp8_dot4_acc32(
                    quantized_input.values[word],
                    gate_up_weight.values[
                        source_row * INPUT_FP8_WORDS + word
                    ],
                    0.0
                ),
                input_scale.values[block] * read_weight_scale(source_row, block),
                sum
            );
        }
    }
    sum = subgroupAdd(sum);
    if (gl_SubgroupInvocationID == 0u && projection < 2u) {
        projection_rows[projection][local_row] = sum;
    }
    barrier();

    if (gl_LocalInvocationID.x < OUTPUT_TILE_ROWS / 2u) {
        uint output_row =
            gl_WorkGroupID.x * OUTPUT_TILE_ROWS + gl_LocalInvocationID.x * 2u;
        if (output_row < OUTPUT_SIZE) {
            float gate_lo = round_bf16(
                projection_rows[0][gl_LocalInvocationID.x * 2u]
            );
            float up_lo = round_bf16(
                projection_rows[1][gl_LocalInvocationID.x * 2u]
            );
            uint lo = f32_to_bf16(rounded_silu(gate_lo) * up_lo);
            uint hi = 0u;
            if (output_row + 1u < OUTPUT_SIZE) {
                float gate_hi = round_bf16(
                    projection_rows[0][gl_LocalInvocationID.x * 2u + 1u]
                );
                float up_hi = round_bf16(
                    projection_rows[1][gl_LocalInvocationID.x * 2u + 1u]
                );
                hi = f32_to_bf16(rounded_silu(gate_hi) * up_hi);
            }
            output_frame.words[output_row / 2u] = (hi << 16u) | lo;
        }
    }
}
