#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_spirv_intrinsics : require

spirv_instruction(
    extensions = ["SPV_VALVE_mixed_float_dot_product"],
    capabilities = [6915],
    id = 6918
)
float fp8_dot4_acc32(fe4m3vec4 a, fe4m3vec4 b, float accumulator);

layout(local_size_x = {{LOCAL_SIZE_X}}, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QuantizedHiddenFrames { fe4m3vec4 values[]; } quantized_hidden_frames;
layout(set = 0, binding = 1) readonly buffer HiddenScales { float values[]; } hidden_scales;
layout(set = 0, binding = 2) readonly buffer ExpertRoutes { uint words[]; } expert_routes;
layout(set = 0, binding = 3) buffer ExpertIntermediates { uint words[]; } expert_intermediates;
layout(set = 0, binding = 4) readonly buffer ExpertInputWeight { fe4m3vec4 values[]; } expert_input_weight;
layout(set = 0, binding = 5) readonly buffer ExpertInputScaleInv { uint words[]; } expert_input_scale_inv;

layout(push_constant) uniform BatchControl {
    uint batch_width;
    uint expert_start;
    uint expert_count;
    uint owned_route_count;
    uint dispatch_x;
    uint dispatch_y;
    uint dispatch_z;
} batch_control;

const uint BLOCK_ROWS = {{BLOCK_ROWS}}u;
const uint BLOCK_COLUMNS = {{BLOCK_COLUMNS}}u;
const uint HIDDEN_SIZE = {{HIDDEN_SIZE}}u;
const uint INTERMEDIATE_SIZE = {{INTERMEDIATE_SIZE}}u;
const uint NUM_EXPERTS = {{NUM_EXPERTS}}u;
const uint EXPERTS_PER_TOKEN = {{EXPERTS_PER_TOKEN}}u;
const uint TILE_ROWS = {{TILE_ROWS}}u;
const uint TILES_PER_ROUTE = (INTERMEDIATE_SIZE + TILE_ROWS - 1u) / TILE_ROWS;
const uint HIDDEN_FP8_WORDS = HIDDEN_SIZE / 4u;
const uint HIDDEN_BLOCKS = HIDDEN_SIZE / BLOCK_COLUMNS;
const uint BLOCK_FP8_WORDS = BLOCK_COLUMNS / 4u;
const uint INTERMEDIATE_WORDS = INTERMEDIATE_SIZE / 2u;
const uint EXPERT_DATA_WORDS = EXPERTS_PER_TOKEN * INTERMEDIATE_WORDS;
const uint EXPERT_FRAME_WORDS = EXPERT_DATA_WORDS + EXPERTS_PER_TOKEN;
const uint EXPERT_INPUT_ROWS = INTERMEDIATE_SIZE * 2u;
const uint EXPERT_INPUT_WORDS = EXPERT_INPUT_ROWS * HIDDEN_SIZE / 4u;
const uint SCALE_ROWS = (EXPERT_INPUT_ROWS + BLOCK_ROWS - 1u) / BLOCK_ROWS;
const uint SCALE_COLUMNS = HIDDEN_BLOCKS;

shared float hidden_block_scales[HIDDEN_BLOCKS];
shared float gate_block_scales[HIDDEN_BLOCKS];
shared float up_block_scales[HIDDEN_BLOCKS];
shared float activated_rows[TILE_ROWS];

float bf16_to_f32(uint value) { return uintBitsToFloat((value & 0xffffu) << 16); }

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7fffu + lsb) >> 16;
}

float round_bf16(float value) { return bf16_to_f32(f32_to_bf16(value)); }

float read_bf16_word(uint packed, uint index) {
    return bf16_to_f32(packed >> ((index & 1u) * 16u));
}

float read_scale(uint expert, uint row, uint block) {
    uint index = (expert * SCALE_ROWS + row / BLOCK_ROWS) * SCALE_COLUMNS + block;
    return read_bf16_word(expert_input_scale_inv.words[index >> 1u], index);
}

fe4m3vec4 read_weightx4(uint expert, uint row, uint word) {
    uint index = (expert * EXPERT_INPUT_ROWS + row) * HIDDEN_FP8_WORDS + word;
    return expert_input_weight.values[index];
}

void main() {
    uint group = gl_WorkGroupID.x;
    uint linear_route = group / TILES_PER_ROUTE;
    bool route_native = batch_control.expert_count != 0u;
    uint compact_batch = route_native
        ? linear_route / EXPERTS_PER_TOKEN
        : gl_WorkGroupID.y;
    uint compact_route = route_native
        ? linear_route % EXPERTS_PER_TOKEN
        : linear_route;
    uint tile = group % TILES_PER_ROUTE;
    if (
        (route_native && linear_route >= batch_control.owned_route_count)
        || (!route_native && compact_batch >= batch_control.batch_width)
        || (!route_native && compact_route >= EXPERTS_PER_TOKEN)
    ) {
        return;
    }
    uint route_index = expert_intermediates.words[
        compact_batch * EXPERT_FRAME_WORDS
            + EXPERT_DATA_WORDS
            + compact_route
    ];
    uint batch_index = route_index / EXPERTS_PER_TOKEN;
    uint route = route_index % EXPERTS_PER_TOKEN;
    uint route_offset = batch_index * EXPERTS_PER_TOKEN;
    uint expert = expert_routes.words[route_offset + route] & 0xffffu;
    if (expert >= NUM_EXPERTS) {
        return;
    }
    uint expert_start = batch_control.expert_start;
    uint expert_count = route_native
        ? batch_control.expert_count
        : expert_input_weight.values.length() / EXPERT_INPUT_WORDS;
    if (expert < expert_start || expert >= expert_start + expert_count) {
        return;
    }
    expert -= expert_start;

    uint first_row = tile * TILE_ROWS;
    uint lane = gl_LocalInvocationID.x;
    if (lane < HIDDEN_BLOCKS) {
        hidden_block_scales[lane] = hidden_scales.values[
            batch_index * HIDDEN_BLOCKS + lane
        ];
        gate_block_scales[lane] = read_scale(expert, first_row, lane);
        up_block_scales[lane] = read_scale(
            expert,
            INTERMEDIATE_SIZE + first_row,
            lane
        );
    }
    barrier();

    for (
        uint local_row = gl_SubgroupID;
        local_row < TILE_ROWS;
        local_row += gl_NumSubgroups
    ) {
        uint row = first_row + local_row;
        float gate = 0.0;
        float up = 0.0;
        if (row < INTERMEDIATE_SIZE) {
            for (
                uint word = gl_SubgroupInvocationID;
                word < HIDDEN_FP8_WORDS;
                word += gl_SubgroupSize
            ) {
                uint block = word / BLOCK_FP8_WORDS;
                fe4m3vec4 hidden = quantized_hidden_frames.values[
                    batch_index * HIDDEN_FP8_WORDS + word
                ];
                gate = fma(
                    fp8_dot4_acc32(hidden, read_weightx4(expert, row, word), 0.0),
                    hidden_block_scales[block] * gate_block_scales[block],
                    gate
                );
                up = fma(
                    fp8_dot4_acc32(
                        hidden,
                        read_weightx4(expert, INTERMEDIATE_SIZE + row, word),
                        0.0
                    ),
                    hidden_block_scales[block] * up_block_scales[block],
                    up
                );
            }
        }
        gate = subgroupAdd(gate);
        up = subgroupAdd(up);
        if (gl_SubgroupInvocationID == 0u) {
            if (row < INTERMEDIATE_SIZE) {
                gate = round_bf16(gate);
                up = round_bf16(up);
                activated_rows[local_row] = round_bf16(
                    round_bf16(gate / (1.0 + exp(-gate))) * up
                );
            } else {
                activated_rows[local_row] = 0.0;
            }
        }
    }
    barrier();

    if (lane < TILE_ROWS / 2u) {
        uint row = first_row + lane * 2u;
        if (row < INTERMEDIATE_SIZE) {
            uint hi = row + 1u < INTERMEDIATE_SIZE
                ? f32_to_bf16(
                    activated_rows[lane * 2u + 1u]
                )
                : 0u;
            uint output_offset = batch_index * EXPERT_FRAME_WORDS;
            expert_intermediates.words[
                output_offset + route * INTERMEDIATE_WORDS + row / 2u
            ] =
                (hi << 16u)
                | f32_to_bf16(
                    activated_rows[lane * 2u]
                );
        }
    }
}
