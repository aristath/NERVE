#version 450

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Scores { float values[]; } scores;
layout(set = 0, binding = 1) buffer Indices { uint values[]; } indices;

layout(push_constant) uniform BatchControl {
    uint batch_width;
    uint start_stream_tick_low;
    uint start_stream_tick_high;
    uint dynamic_state_capacity;
} batch_control;

const uint MAX_SCORES = {{MAX_SCORES}}u;
const uint TOP_K = {{TOP_K}}u;
const uint COMPRESSION_RATIO = {{COMPRESSION_RATIO}}u;
const uint INDEX_OFFSET = {{INDEX_OFFSET}}u;

shared uint reductions[1024];
shared uint selected_prefix;
shared uint selected_mask;
shared uint selected_rank;
shared uint selected_count;
shared uint selected_keys[{{SORT_CAPACITY}}];
shared uint selected_indices[{{SORT_CAPACITY}}];

uint ordered_float_key(float value) {
    uint bits = floatBitsToUint(value);
    return (bits & 0x80000000u) != 0u ? ~bits : bits ^ 0x80000000u;
}

void reduce_counts(uint lane) {
    for (uint stride = 512u; stride > 0u; stride >>= 1u) {
        barrier();
        if (lane < stride) reductions[lane] += reductions[lane + stride];
    }
    barrier();
}

uint exclusive_prefix_sum(uint lane, uint value) {
    reductions[lane] = value;
    barrier();
    for (uint offset = 1u; offset < 1024u; offset <<= 1u) {
        uint addend = lane >= offset ? reductions[lane - offset] : 0u;
        barrier();
        reductions[lane] += addend;
        barrier();
    }
    return lane == 0u ? 0u : reductions[lane - 1u];
}

bool selected_candidate_precedes(
    uint left_key,
    uint left_index,
    uint right_key,
    uint right_index
) {
    return left_key > right_key
        || (left_key == right_key && left_index < right_index);
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    for (uint position = 0u; position < batch_control.batch_width; ++position) {
        uint absolute_tick = batch_control.start_stream_tick_low + position;
        uint score_count = min(
            (absolute_tick + 1u) / COMPRESSION_RATIO,
            MAX_SCORES
        );
        uint result_count = min(score_count, TOP_K);
        uint score_base = position * MAX_SCORES;
        uint output_base = position * TOP_K;
        for (uint output_slot = lane; output_slot < TOP_K; output_slot += 1024u) {
            indices.values[output_base + output_slot] = 0xffffffffu;
        }
        if (lane == 0u) {
            selected_prefix = 0u;
            selected_mask = 0u;
            selected_rank = result_count;
        }
        barrier();
        if (result_count != 0u) {
            for (int bit_index = 31; bit_index >= 0; --bit_index) {
                uint bit = 1u << uint(bit_index);
                uint count = 0u;
                for (uint candidate = lane;
                     candidate < score_count;
                     candidate += 1024u) {
                    uint key = ordered_float_key(scores.values[score_base + candidate]);
                    if ((key & selected_mask) == selected_prefix && (key & bit) != 0u) {
                        ++count;
                    }
                }
                reductions[lane] = count;
                reduce_counts(lane);
                if (lane == 0u) {
                    if (reductions[0] >= selected_rank) selected_prefix |= bit;
                    else selected_rank -= reductions[0];
                    selected_mask |= bit;
                }
                barrier();
            }

            if (lane < {{SORT_CAPACITY}}u) {
                selected_keys[lane] = 0u;
                selected_indices[lane] = 0xffffffffu;
            }
            barrier();

            uint chunk_start = (score_count * lane) / 1024u;
            uint chunk_end = (score_count * (lane + 1u)) / 1024u;
            uint local_count = 0u;
            for (uint candidate = chunk_start; candidate < chunk_end; ++candidate) {
                uint key = ordered_float_key(scores.values[score_base + candidate]);
                if (key > selected_prefix) ++local_count;
            }
            uint selected_base = exclusive_prefix_sum(lane, local_count);
            if (lane == 1023u) selected_count = selected_base + local_count;
            barrier();

            uint local_ordinal = 0u;
            for (uint candidate = chunk_start; candidate < chunk_end; ++candidate) {
                uint key = ordered_float_key(scores.values[score_base + candidate]);
                if (key > selected_prefix) {
                    uint slot = selected_base + local_ordinal;
                    if (slot < result_count) {
                        selected_keys[slot] = key;
                        selected_indices[slot] = candidate;
                    }
                    ++local_ordinal;
                }
            }
            barrier();

            local_count = 0u;
            for (uint candidate = chunk_start; candidate < chunk_end; ++candidate) {
                if (ordered_float_key(scores.values[score_base + candidate])
                    == selected_prefix) {
                    ++local_count;
                }
            }
            selected_base = exclusive_prefix_sum(lane, local_count) + selected_count;
            barrier();
            local_ordinal = 0u;
            for (uint candidate = chunk_start; candidate < chunk_end; ++candidate) {
                uint key = ordered_float_key(scores.values[score_base + candidate]);
                if (key == selected_prefix) {
                    uint slot = selected_base + local_ordinal;
                    if (slot < result_count) {
                        selected_keys[slot] = key;
                        selected_indices[slot] = candidate;
                    }
                    ++local_ordinal;
                }
            }
            barrier();

            for (uint span = 2u; span <= {{SORT_CAPACITY}}u; span <<= 1u) {
                for (uint stride = span >> 1u; stride > 0u; stride >>= 1u) {
                    uint partner = lane ^ stride;
                    if (lane < {{SORT_CAPACITY}}u && partner > lane) {
                        uint left_key = selected_keys[lane];
                        uint left_index = selected_indices[lane];
                        uint right_key = selected_keys[partner];
                        uint right_index = selected_indices[partner];
                        bool descending = (lane & span) == 0u;
                        bool ordered = descending
                            ? selected_candidate_precedes(
                                left_key, left_index, right_key, right_index
                            )
                            : selected_candidate_precedes(
                                right_key, right_index, left_key, left_index
                            );
                        if (!ordered) {
                            selected_keys[lane] = right_key;
                            selected_indices[lane] = right_index;
                            selected_keys[partner] = left_key;
                            selected_indices[partner] = left_index;
                        }
                    }
                    barrier();
                }
            }

            if (lane < result_count) {
                indices.values[output_base + lane] =
                    INDEX_OFFSET + selected_indices[lane];
            }
            barrier();
        }
    }
}
