#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer CurrentFrames { uint words[]; } current_frames;
layout(set = 0, binding = 4) buffer StateWrite { uint words[]; } state_write;
layout(set = 0, binding = 30) buffer StateSnapshots { uint words[]; } state_snapshots;

layout(push_constant) uniform BatchControl {
    uint batch_width;
    uint start_stream_tick_low;
    uint start_stream_tick_high;
    uint dynamic_state_capacity;
    uint state_snapshots_enabled;
} batch_control;

const uint FRAME_COUNT = {{FRAME_COUNT}}u;
const uint FRAME_WORD_COUNT = ({{HIDDEN_SIZE}}u + 1u) / 2u;
const uint STATE_WORD_COUNT = FRAME_COUNT * FRAME_WORD_COUNT;
const uint STATE_PAGE_TABLE_WORDS = 9u;

uint state_write_word(uint logical_word) {
    uint logical_byte = logical_word * 4u;
    if (logical_byte < state_write.words[2]) {
        return (state_write.words[3] + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - state_write.words[2];
    uint page_bytes = state_write.words[4];
    uint physical_page =
        state_write.words[STATE_PAGE_TABLE_WORDS + dynamic_byte / page_bytes];
    return (
        state_write.words[8]
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    for (uint position = 0u; position < batch_control.batch_width; ++position) {
        uint absolute_tick = batch_control.start_stream_tick_low + position;
        uint slot_word = (absolute_tick % FRAME_COUNT) * FRAME_WORD_COUNT;
        uint input_base = position * FRAME_WORD_COUNT;
        for (uint word = lane; word < FRAME_WORD_COUNT; word += 64u) {
            state_write.words[state_write_word(slot_word + word)] =
                current_frames.words[input_base + word];
        }
        barrier();
        if (batch_control.state_snapshots_enabled != 0u) {
            uint snapshot_base = position * STATE_WORD_COUNT;
            for (uint word = lane; word < STATE_WORD_COUNT; word += 64u) {
                state_snapshots.words[snapshot_base + word] =
                    state_write.words[state_write_word(word)];
            }
        }
        barrier();
    }
}
