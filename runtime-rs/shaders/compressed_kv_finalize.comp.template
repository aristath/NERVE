#version 460

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_float_e4m3 : require

layout(local_size_x = {{HEAD_WIDTH}}, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer PooledInput { float values[]; } pooled_input;
layout(set = 0, binding = 1) buffer CompressedOutput { uint words[]; } compressed_output;
layout(set = 0, binding = 2) readonly buffer NormWeight { uint words[]; } norm_weight;
layout(set = 0, binding = 3) readonly buffer StreamControl { uint words[]; } stream_control;

const uint HEAD_WIDTH = {{HEAD_WIDTH}}u;
const uint ROTARY_WIDTH = {{ROTARY_WIDTH}}u;
const uint NON_ROTARY_WIDTH = {{NON_ROTARY_WIDTH}}u;
const float NORM_EPS = {{NORM_EPS}};
const float ROPE_THETA = {{ROPE_THETA}};
const bool ROPE_YARN = {{ROPE_YARN}};
const float ROPE_FACTOR = {{ROPE_FACTOR}};
const float ROPE_CORRECTION_LOW = {{ROPE_CORRECTION_LOW}};
const float ROPE_CORRECTION_HIGH = {{ROPE_CORRECTION_HIGH}};
const float ROPE_ATTENTION_FACTOR = {{ROPE_ATTENTION_FACTOR}};
const bool ROPE_INTERLEAVED = {{ROPE_INTERLEAVED}};
const int POSITION_OFFSET = {{POSITION_OFFSET}};
const uint QUANT_BLOCK_COLUMNS = {{QUANT_BLOCK_COLUMNS}}u;
const uint QUANT_BLOCK_COUNT = NON_ROTARY_WIDTH / QUANT_BLOCK_COLUMNS;

shared float values[HEAD_WIDTH];
shared float reduction[HEAD_WIDTH];
shared float block_scales[QUANT_BLOCK_COUNT];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16u);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7fffu + lsb) >> 16u;
}

float round_bf16(float value) {
    return bf16_to_f32(f32_to_bf16(value));
}

float read_norm_weight(uint dim) {
    uint packed = norm_weight.words[dim >> 1u];
    return bf16_to_f32(packed >> ((dim & 1u) * 16u));
}

float rope_inverse_frequency(uint frequency_index) {
    float inverse_frequency = pow(
        ROPE_THETA,
        -2.0 * float(frequency_index) / float(ROTARY_WIDTH)
    );
    if (!ROPE_YARN) return inverse_frequency;
    float ramp = clamp(
        (float(frequency_index) - ROPE_CORRECTION_LOW)
            / (ROPE_CORRECTION_HIGH - ROPE_CORRECTION_LOW),
        0.0,
        1.0
    );
    return mix(inverse_frequency, inverse_frequency / ROPE_FACTOR, ramp);
}

float rotate_tail(uint dim) {
    uint rotary_dim = dim - NON_ROTARY_WIDTH;
    uint frequency_index = ROPE_INTERLEAVED
        ? rotary_dim / 2u
        : rotary_dim % (ROTARY_WIDTH / 2u);
    uint paired_rotary_dim = ROPE_INTERLEAVED
        ? ((rotary_dim & 1u) == 0u ? rotary_dim + 1u : rotary_dim - 1u)
        : (rotary_dim < ROTARY_WIDTH / 2u
            ? rotary_dim + ROTARY_WIDTH / 2u
            : rotary_dim - ROTARY_WIDTH / 2u);
    float paired_sign = (
        ROPE_INTERLEAVED ? (rotary_dim & 1u) == 0u : rotary_dim < ROTARY_WIDTH / 2u
    ) ? -1.0 : 1.0;
    float angle = (float(stream_control.words[1]) + float(POSITION_OFFSET))
        * rope_inverse_frequency(frequency_index);
    float cosine = cos(angle) * ROPE_ATTENTION_FACTOR;
    float sine = sin(angle) * ROPE_ATTENTION_FACTOR;
    return values[dim] * cosine
        + paired_sign * values[NON_ROTARY_WIDTH + paired_rotary_dim] * sine;
}

float round_power_of_two_scale(float maximum) {
    return exp2(ceil(log2(max(maximum, 1e-4) / 448.0)));
}

float quantize_dequantize_e4m3(float value, float scale) {
    fe4m3vec4 quantized = fe4m3vec4(vec4(clamp(value / scale, -448.0, 448.0)));
    u8vec4 bits = floate4m3BitsToUintEXT(quantized);
    vec4 restored = vec4(uintBitsToFloate4m3EXT(bits));
    return restored.x * scale;
}

void main() {
    uint dim = gl_LocalInvocationID.x;
    float rounded_input = round_bf16(pooled_input.values[dim]);
    values[dim] = rounded_input;
    reduction[dim] = rounded_input * rounded_input;
    barrier();
    for (uint stride = HEAD_WIDTH / 2u; stride > 0u; stride >>= 1u) {
        if (dim < stride) reduction[dim] += reduction[dim + stride];
        barrier();
    }
    float inverse_rms = inversesqrt(reduction[0] / float(HEAD_WIDTH) + NORM_EPS);
    values[dim] = round_bf16(rounded_input * inverse_rms * read_norm_weight(dim));
    barrier();
    if (dim >= NON_ROTARY_WIDTH) {
        values[dim] = round_bf16(rotate_tail(dim));
    }
    barrier();

    if (dim < NON_ROTARY_WIDTH && dim % QUANT_BLOCK_COLUMNS == 0u) {
        float maximum = 0.0;
        for (uint offset = 0u; offset < QUANT_BLOCK_COLUMNS; ++offset) {
            maximum = max(maximum, abs(values[dim + offset]));
        }
        block_scales[dim / QUANT_BLOCK_COLUMNS] = round_power_of_two_scale(maximum);
    }
    barrier();
    if (dim < NON_ROTARY_WIDTH) {
        float scale = block_scales[dim / QUANT_BLOCK_COLUMNS];
        values[dim] = round_bf16(quantize_dequantize_e4m3(values[dim], scale));
    }
    barrier();
    if ((dim & 1u) == 0u) {
        compressed_output.words[dim >> 1u] =
            (f32_to_bf16(values[dim + 1u]) << 16u) | f32_to_bf16(values[dim]);
    }
}
