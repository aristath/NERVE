#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer CurrentFrame {
    uint words[];
} current_frame;

layout(set = 0, binding = 4) buffer StateWrite {
    uint words[];
} state_write;

layout(set = 0, binding = 6) readonly buffer StreamControl {
    uint words[];
} stream_control;

const uint FRAME_COUNT = {{FRAME_COUNT}}u;
const uint FRAME_WORD_COUNT = ({{HIDDEN_SIZE}}u + 1u) / 2u;
const uint STATE_PAGE_TABLE_WORDS = 9u;

uint state_write_word(uint logical_word) {
    uint logical_byte = logical_word * 4u;
    if (logical_byte < state_write.words[2]) {
        return (state_write.words[3] + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - state_write.words[2];
    uint page_bytes = state_write.words[4];
    uint physical_page =
        state_write.words[STATE_PAGE_TABLE_WORDS + dynamic_byte / page_bytes];
    return (
        state_write.words[8]
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}

void main() {
    uint slot = stream_control.words[1] % FRAME_COUNT;
    uint slot_word = slot * FRAME_WORD_COUNT;
    for (
        uint word_index = gl_LocalInvocationID.x;
        word_index < FRAME_WORD_COUNT;
        word_index += gl_WorkGroupSize.x
    ) {
        state_write.words[state_write_word(slot_word + word_index)] =
            current_frame.words[word_index];
    }
}
