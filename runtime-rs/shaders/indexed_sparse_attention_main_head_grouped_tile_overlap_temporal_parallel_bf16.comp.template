#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = {{LOCAL_SIZE}}, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QueryFrames { uint words[]; } query_frames;
layout(set = 0, binding = 1) readonly buffer LocalStateView { uint words[]; } local_state;
#if {{HAS_COMPRESSED}}
layout(set = 0, binding = 2) readonly buffer CompressedStateView { uint words[]; } compressed_state;
layout(set = 0, binding = 3) readonly buffer CompressedIndices { uint words[]; } compressed_indices;
#endif
layout(set = 0, binding = {{OUTPUT_BINDING}}) buffer OutputFrames { uint words[]; } output_frames;
layout(set = 0, binding = {{SINK_BINDING}}) readonly buffer AttentionSinks { uint words[]; } attention_sinks;
layout(set = 0, binding = 30) readonly buffer LocalStateSnapshots { uint words[]; } local_state_snapshots;

layout(push_constant) uniform BatchControl {
    uint batch_width;
    uint start_stream_tick_low;
    uint start_stream_tick_high;
    uint dynamic_state_capacity;
    uint state_snapshots_enabled;
} batch_control;

const uint QUERY_HEADS = {{QUERY_HEADS}}u;
const uint HEAD_GROUP = {{HEAD_GROUP}}u;
const uint HEAD_WIDTH = {{HEAD_WIDTH}}u;
const uint LOCAL_WINDOW = {{LOCAL_WINDOW}}u;
const uint COMPRESSION_RATIO = {{COMPRESSION_RATIO}}u;
const uint MAX_COMPRESSED_INDICES = {{MAX_COMPRESSED_INDICES}}u;
const uint TILE_TOKENS = 64u;
const uint MAX_SCORE_SUBGROUP_COUNT = HEAD_WIDTH / 4u;
const uint STATE_PAGE_TABLE_WORDS = 9u;
const uint QUERY_FRAME_WORDS = QUERY_HEADS * HEAD_WIDTH / 2u;
const uint OUTPUT_FRAME_WORDS = QUERY_FRAME_WORDS;
const uint LOCAL_STATE_WORDS = LOCAL_WINDOW * HEAD_WIDTH / 2u;
const float ATTENTION_SCALE = {{ATTENTION_SCALE}};
const float LOWEST_FLOAT = -3.4028234663852886e38;

shared float score_partials[HEAD_GROUP * 2u * MAX_SCORE_SUBGROUP_COUNT];
shared float tile_scores[HEAD_GROUP * 2u * TILE_TOKENS];
shared float tile_weights[HEAD_GROUP * 2u * TILE_TOKENS];
shared float tile_accumulator_scales[HEAD_GROUP * 2u];
shared float running_maxima[HEAD_GROUP];
shared float running_denominators[HEAD_GROUP];
shared float output_values[HEAD_GROUP * HEAD_WIDTH];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16u);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7fffu + lsb) >> 16u;
}

float read_bf16(uint packed, uint element_index) {
    return bf16_to_f32(packed >> ((element_index & 1u) * 16u));
}

uint local_state_word(uint logical_word) {
    uint logical_byte = logical_word * 4u;
    if (logical_byte < local_state.words[2]) {
        return (local_state.words[3] + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - local_state.words[2];
    uint page_bytes = local_state.words[4];
    uint physical_page = local_state.words[
        STATE_PAGE_TABLE_WORDS + dynamic_byte / page_bytes
    ];
    return (
        local_state.words[8]
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}

#if {{HAS_COMPRESSED}}
uint compressed_state_word(uint logical_word) {
    uint logical_byte = logical_word * 4u;
    if (logical_byte < compressed_state.words[2]) {
        return (compressed_state.words[3] + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - compressed_state.words[2];
    uint page_bytes = compressed_state.words[4];
    uint physical_page = compressed_state.words[
        STATE_PAGE_TABLE_WORDS + dynamic_byte / page_bytes
    ];
    return (
        compressed_state.words[8]
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}
#endif

float read_query(uint batch_position, uint head, uint dim) {
    uint element = head * HEAD_WIDTH + dim;
    uint word = batch_position * QUERY_FRAME_WORDS + (element >> 1u);
    return read_bf16(query_frames.words[word], element);
}

float read_local_key_value(
    uint batch_position,
    uint absolute_tick,
    uint capacity,
    uint dim
) {
    uint slot = absolute_tick % capacity;
    uint element = slot * HEAD_WIDTH + dim;
    uint packed = batch_control.state_snapshots_enabled != 0u
        ? local_state_snapshots.words[
            batch_position * LOCAL_STATE_WORDS + (element >> 1u)
        ]
        : local_state.words[local_state_word(element >> 1u)];
    return read_bf16(packed, element);
}

#if {{HAS_COMPRESSED}}
uint compressed_index(uint batch_position, uint position) {
    return compressed_indices.words[
        batch_position * MAX_COMPRESSED_INDICES + position
    ];
}

bool valid_compressed_index(
    uint batch_position,
    uint position,
    uint compressed_count
) {
    uint index = compressed_index(batch_position, position);
    return index != 0xffffffffu
        && index >= LOCAL_WINDOW
        && index - LOCAL_WINDOW < compressed_count;
}

float read_compressed_key_value(uint batch_position, uint position, uint dim) {
    uint slot = compressed_index(batch_position, position) - LOCAL_WINDOW;
    uint element = slot * HEAD_WIDTH + dim;
    return read_bf16(
        compressed_state.words[compressed_state_word(element >> 1u)],
        element
    );
}
#endif

bool token_valid(
    uint batch_position,
    uint token,
    uint local_tokens,
    uint compressed_count
) {
    if (token < local_tokens) {
        return true;
    }
#if {{HAS_COMPRESSED}}
    return valid_compressed_index(
        batch_position,
        token - local_tokens,
        compressed_count
    );
#else
    return false;
#endif
}

float read_token_value(
    uint batch_position,
    uint token,
    uint dim,
    uint local_tokens,
    uint oldest_tick,
    uint local_capacity
) {
    if (token < local_tokens) {
        return read_local_key_value(
            batch_position,
            oldest_tick + token,
            local_capacity,
            dim
        );
    }
#if {{HAS_COMPRESSED}}
    return read_compressed_key_value(
        batch_position,
        token - local_tokens,
        dim
    );
#else
    return 0.0;
#endif
}

uint partial_offset(uint head_in_group, uint partial_buffer, uint subgroup) {
    return (
        (head_in_group * 2u + partial_buffer) * MAX_SCORE_SUBGROUP_COUNT
        + subgroup
    );
}

uint tile_offset(uint head_in_group, uint tile_buffer, uint tile_token) {
    return (
        (head_in_group * 2u + tile_buffer) * TILE_TOKENS
        + tile_token
    );
}

uint scale_offset(uint head_in_group, uint tile_buffer) {
    return head_in_group * 2u + tile_buffer;
}

void produce_score_partials(
    uint batch_position,
    uint partial_buffer,
    uint token,
    float query_values[HEAD_GROUP],
    uint dim,
    uint local_tokens,
    uint compressed_count,
    uint oldest_tick,
    uint local_capacity
) {
    bool valid = token_valid(
        batch_position,
        token,
        local_tokens,
        compressed_count
    );
    float key_value = valid
        ? read_token_value(
            batch_position,
            token,
            dim,
            local_tokens,
            oldest_tick,
            local_capacity
        )
        : 0.0;
    for (uint head = 0u; head < HEAD_GROUP; ++head) {
        float partial = subgroupAdd(query_values[head] * key_value);
        if (subgroupElect()) {
            score_partials[
                partial_offset(head, partial_buffer, gl_SubgroupID)
            ] = partial;
        }
    }
}

void finalize_tile_scores(
    uint head_in_group,
    uint tile_buffer,
    uint tile_count
) {
    float tile_maximum = LOWEST_FLOAT;
    for (uint tile_token = 0u; tile_token < tile_count; ++tile_token) {
        tile_maximum = max(
            tile_maximum,
            tile_scores[tile_offset(head_in_group, tile_buffer, tile_token)]
        );
    }
    float next_maximum = max(
        running_maxima[head_in_group],
        tile_maximum
    );
    float old_scale = exp(running_maxima[head_in_group] - next_maximum);
    float tile_denominator = 0.0;
    for (uint tile_token = 0u; tile_token < tile_count; ++tile_token) {
        uint offset = tile_offset(head_in_group, tile_buffer, tile_token);
        float weight = exp(tile_scores[offset] - next_maximum);
        tile_weights[offset] = weight;
        tile_denominator += weight;
    }
    running_denominators[head_in_group] =
        running_denominators[head_in_group] * old_scale + tile_denominator;
    running_maxima[head_in_group] = next_maximum;
    tile_accumulator_scales[
        scale_offset(head_in_group, tile_buffer)
    ] = old_scale;
}

void main() {
    uint query_head_base = gl_WorkGroupID.x * HEAD_GROUP;
    uint batch_position = gl_WorkGroupID.y;
    uint invocation = gl_LocalInvocationID.x;
    bool score_worker = invocation < HEAD_WIDTH;
    bool value_worker = invocation >= HEAD_WIDTH;
    bool controller = invocation == HEAD_WIDTH;
    uint score_dim = invocation;
    uint value_dim = value_worker ? invocation - HEAD_WIDTH : 0u;
    uint score_subgroup_count = HEAD_WIDTH / gl_SubgroupSize;
    if (
        query_head_base + HEAD_GROUP > QUERY_HEADS
        || batch_position >= batch_control.batch_width
    ) {
        return;
    }

    uint stream_tick = batch_control.start_stream_tick_low + batch_position;
    uint local_capacity = min(
        batch_control.dynamic_state_capacity,
        LOCAL_WINDOW
    );
    uint local_tokens = local_capacity == 0u
        ? 0u
        : min(stream_tick + 1u, local_capacity);
    uint oldest_tick = stream_tick + 1u - local_tokens;
#if {{HAS_COMPRESSED}}
    uint compressed_count = min(
        (stream_tick + 1u) / COMPRESSION_RATIO,
        MAX_COMPRESSED_INDICES
    );
#else
    uint compressed_count = 0u;
#endif
    uint total_tokens = local_tokens + compressed_count;
    uint tile_total = (total_tokens + TILE_TOKENS - 1u) / TILE_TOKENS;
    float query_values[HEAD_GROUP];
    float accumulators[HEAD_GROUP];
    for (uint head = 0u; head < HEAD_GROUP; ++head) {
        query_values[head] = score_worker
            ? read_query(batch_position, query_head_base + head, score_dim)
            : 0.0;
        accumulators[head] = 0.0;
    }

    if (controller) {
        for (uint head = 0u; head < HEAD_GROUP; ++head) {
            running_maxima[head] = uintBitsToFloat(
                attention_sinks.words[query_head_base + head]
            );
            running_denominators[head] = 1.0;
        }
    }
    barrier();

    for (uint tile_index = 0u; tile_index < tile_total; ++tile_index) {
        uint tile_buffer = tile_index & 1u;
        uint previous_buffer = tile_buffer ^ 1u;
        uint tile_start = tile_index * TILE_TOKENS;
        uint tile_count = min(TILE_TOKENS, total_tokens - tile_start);
        uint previous_count = tile_index == 0u
            ? 0u
            : min(TILE_TOKENS, total_tokens - (tile_start - TILE_TOKENS));
        uint overlap_count = max(tile_count, previous_count);
        float previous_tile_accumulators[HEAD_GROUP];
        for (uint head = 0u; head < HEAD_GROUP; ++head) {
            previous_tile_accumulators[head] = 0.0;
        }

        if (score_worker && tile_count > 0u) {
            produce_score_partials(
                batch_position,
                0u,
                tile_start,
                query_values,
                score_dim,
                local_tokens,
                compressed_count,
                oldest_tick,
                local_capacity
            );
        }
        barrier();

        for (uint tile_token = 0u; tile_token < overlap_count; ++tile_token) {
            if (tile_token < tile_count) {
                uint partial_buffer = tile_token & 1u;
                if (controller) {
                    uint token = tile_start + tile_token;
                    bool valid = token_valid(
                        batch_position,
                        token,
                        local_tokens,
                        compressed_count
                    );
                    for (uint head = 0u; head < HEAD_GROUP; ++head) {
                        float score = 0.0;
                        for (uint subgroup = 0u;
                             subgroup < score_subgroup_count;
                             ++subgroup) {
                            score += score_partials[
                                partial_offset(head, partial_buffer, subgroup)
                            ];
                        }
                        tile_scores[
                            tile_offset(head, tile_buffer, tile_token)
                        ] = valid ? score * ATTENTION_SCALE : LOWEST_FLOAT;
                    }
                }
                if (score_worker && tile_token + 1u < tile_count) {
                    produce_score_partials(
                        batch_position,
                        partial_buffer ^ 1u,
                        tile_start + tile_token + 1u,
                        query_values,
                        score_dim,
                        local_tokens,
                        compressed_count,
                        oldest_tick,
                        local_capacity
                    );
                }
            }
            if (value_worker && tile_token < previous_count) {
                uint previous_token = tile_start - TILE_TOKENS + tile_token;
                if (token_valid(
                    batch_position,
                    previous_token,
                    local_tokens,
                    compressed_count
                )) {
                    float value = read_token_value(
                        batch_position,
                        previous_token,
                        value_dim,
                        local_tokens,
                        oldest_tick,
                        local_capacity
                    );
                    for (uint head = 0u; head < HEAD_GROUP; ++head) {
                        previous_tile_accumulators[head] += tile_weights[
                            tile_offset(head, previous_buffer, tile_token)
                        ] * value;
                    }
                }
            }
            barrier();
        }

        if (controller) {
            for (uint head = 0u; head < HEAD_GROUP; ++head) {
                finalize_tile_scores(head, tile_buffer, tile_count);
            }
        }
        if (value_worker && tile_index > 0u) {
            for (uint head = 0u; head < HEAD_GROUP; ++head) {
                accumulators[head] = accumulators[head]
                    * tile_accumulator_scales[
                        scale_offset(head, previous_buffer)
                    ]
                    + previous_tile_accumulators[head];
            }
        }
        barrier();
    }

    if (value_worker && tile_total > 0u) {
        uint final_tile = tile_total - 1u;
        uint final_buffer = final_tile & 1u;
        uint final_start = final_tile * TILE_TOKENS;
        uint final_count = min(TILE_TOKENS, total_tokens - final_start);
        float final_tile_accumulators[HEAD_GROUP];
        for (uint head = 0u; head < HEAD_GROUP; ++head) {
            final_tile_accumulators[head] = 0.0;
        }
        for (uint tile_token = 0u; tile_token < final_count; ++tile_token) {
            uint token = final_start + tile_token;
            if (token_valid(
                batch_position,
                token,
                local_tokens,
                compressed_count
            )) {
                float value = read_token_value(
                    batch_position,
                    token,
                    value_dim,
                    local_tokens,
                    oldest_tick,
                    local_capacity
                );
                for (uint head = 0u; head < HEAD_GROUP; ++head) {
                    final_tile_accumulators[head] += tile_weights[
                        tile_offset(head, final_buffer, tile_token)
                    ] * value;
                }
            }
        }
        for (uint head = 0u; head < HEAD_GROUP; ++head) {
            accumulators[head] = accumulators[head]
                * tile_accumulator_scales[scale_offset(head, final_buffer)]
                + final_tile_accumulators[head];
            output_values[head * HEAD_WIDTH + value_dim] =
                accumulators[head] / running_denominators[head];
        }
    }
    barrier();

    if (value_worker && (value_dim & 1u) == 0u) {
        for (uint head = 0u; head < HEAD_GROUP; ++head) {
            uint query_head = query_head_base + head;
            uint element = query_head * HEAD_WIDTH + value_dim;
            uint output_base = head * HEAD_WIDTH + value_dim;
            output_frames.words[
                batch_position * OUTPUT_FRAME_WORDS + (element >> 1u)
            ] = f32_to_bf16(output_values[output_base])
                | (f32_to_bf16(output_values[output_base + 1u]) << 16u);
        }
    }
}
