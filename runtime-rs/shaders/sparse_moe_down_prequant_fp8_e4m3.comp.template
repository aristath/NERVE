#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_EXT_buffer_reference2 : require

spirv_instruction(
    extensions = ["SPV_VALVE_mixed_float_dot_product"],
    capabilities = [6915],
    id = 6918
)
float fp8_dot4_acc32(fe4m3vec4 a, fe4m3vec4 b, float accumulator);

layout(local_size_x = {{LOCAL_SIZE_X}}, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QuantizedIntermediates { uint words[]; } quantized_intermediates;
layout(set = 0, binding = 1) readonly buffer IntermediateScales { float values[]; } intermediate_scales;
layout(set = 0, binding = 2) readonly buffer RouteMap { uint values[]; } route_map;
layout(set = 0, binding = 3) readonly buffer ExpertRoutes { uint words[]; } expert_routes;
layout(set = 0, binding = 4) buffer ExpertOutputs { uint words[]; } expert_outputs;
layout(set = 0, binding = 5) readonly buffer DynamicResourceAddresses { uint words[]; } dynamic_resource_addresses;
layout(set = 0, binding = 6) readonly buffer DynamicParameterSlots { uint words[]; } dynamic_parameter_slots;
layout(push_constant) uniform DispatchControl { uint expert_start; } dispatch_control;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer DynamicU32Buffer {
    uint words[];
};

const uint BLOCK_ROWS = {{BLOCK_ROWS}}u;
const uint BLOCK_COLUMNS = {{BLOCK_COLUMNS}}u;
const uint HIDDEN_SIZE = {{HIDDEN_SIZE}}u;
const uint INTERMEDIATE_SIZE = {{INTERMEDIATE_SIZE}}u;
const uint NUM_EXPERTS = {{NUM_EXPERTS}}u;
const uint EXPERTS_PER_TOKEN = {{EXPERTS_PER_TOKEN}}u;
const uint TILE_ROWS = {{TILE_ROWS}}u;
const uint TILES_PER_ROUTE = (HIDDEN_SIZE + TILE_ROWS - 1u) / TILE_ROWS;
const uint HIDDEN_WORDS = HIDDEN_SIZE / 2u;
const uint INTERMEDIATE_FP8_WORDS = INTERMEDIATE_SIZE / 4u;
const uint INTERMEDIATE_BLOCKS = INTERMEDIATE_SIZE / BLOCK_COLUMNS;
const uint BLOCK_FP8_WORDS = BLOCK_COLUMNS / 4u;
const uint EXPERT_OUTPUT_WORDS = HIDDEN_SIZE * INTERMEDIATE_SIZE / 4u;
const uint SCALE_ROWS = (HIDDEN_SIZE + BLOCK_ROWS - 1u) / BLOCK_ROWS;
const uint SCALE_COLUMNS = INTERMEDIATE_BLOCKS;
const uint ADDRESS_RECORD_WORDS = 8u;
const uint DYNAMIC_PARAMETER_COUNT = 2u;
const uint UNBOUND_PARAMETER_SLOT = 0xffffffffu;

shared fe4m3vec4 cached_intermediate[INTERMEDIATE_FP8_WORDS];
shared float cached_intermediate_scales[INTERMEDIATE_BLOCKS];
shared float output_rows[TILE_ROWS];

float bf16_to_f32(uint value) { return uintBitsToFloat((value & 0xffffu) << 16); }

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7fffu + lsb) >> 16;
}

float round_bf16(float value) { return bf16_to_f32(f32_to_bf16(value)); }

float read_bf16_word(uint packed, uint index) {
    return bf16_to_f32(packed >> ((index & 1u) * 16u));
}

fe4m3vec4 read_fp8x4(uint packed) {
    return uintBitsToFloate4m3EXT(u8vec4(
        uint8_t(packed),
        uint8_t(packed >> 8u),
        uint8_t(packed >> 16u),
        uint8_t(packed >> 24u)
    ));
}

uint dynamic_parameter_slot(uint expert, uint parameter) {
    return dynamic_parameter_slots.words[
        expert * DYNAMIC_PARAMETER_COUNT + parameter
    ];
}

uint64_t dynamic_parameter_address(uint slot) {
    uint record = slot * ADDRESS_RECORD_WORDS;
    return uint64_t(dynamic_resource_addresses.words[record])
        | (uint64_t(dynamic_resource_addresses.words[record + 1u]) << 32u);
}

DynamicU32Buffer dynamic_parameter(uint expert, uint parameter) {
    return DynamicU32Buffer(dynamic_parameter_address(
        dynamic_parameter_slot(expert, parameter)
    ));
}

float read_scale(DynamicU32Buffer scale, uint row, uint block) {
    uint index = (row / BLOCK_ROWS) * SCALE_COLUMNS + block;
    return read_bf16_word(scale.words[index >> 1u], index);
}

fe4m3vec4 read_weightx4(DynamicU32Buffer weight, uint row, uint column) {
    uint word = (row * INTERMEDIATE_SIZE + column) >> 2u;
    return read_fp8x4(weight.words[word]);
}

void main() {
    uint group = gl_WorkGroupID.x;
    uint compact_route = group / TILES_PER_ROUTE;
    uint tile = group % TILES_PER_ROUTE;
    if (compact_route >= EXPERTS_PER_TOKEN) {
        return;
    }
    uint route = route_map.values[compact_route];
    if (route >= EXPERTS_PER_TOKEN) {
        return;
    }
    uint packed_route = expert_routes.words[route];
    uint expert = packed_route & 0xffffu;
    if (expert >= NUM_EXPERTS) {
        return;
    }
    if (
        dynamic_parameter_slot(expert, 0u) == UNBOUND_PARAMETER_SLOT
        || dynamic_parameter_slot(expert, 1u) == UNBOUND_PARAMETER_SLOT
    ) {
        return;
    }
    DynamicU32Buffer expert_output_weight = dynamic_parameter(expert, 0u);
    DynamicU32Buffer expert_output_scale_inv = dynamic_parameter(expert, 1u);
    float route_weight = bf16_to_f32(packed_route >> 16u);

    uint lane = gl_LocalInvocationID.x;
    if (lane < INTERMEDIATE_FP8_WORDS) {
        cached_intermediate[lane] = read_fp8x4(
            quantized_intermediates.words[
                route * INTERMEDIATE_FP8_WORDS + lane
            ]
        );
    }
    if (lane < INTERMEDIATE_BLOCKS) {
        cached_intermediate_scales[lane] =
            intermediate_scales.values[route * INTERMEDIATE_BLOCKS + lane];
    }
    barrier();

    uint first_row = tile * TILE_ROWS;
    for (
        uint local_row = gl_SubgroupID;
        local_row < TILE_ROWS;
        local_row += gl_NumSubgroups
    ) {
        uint row = first_row + local_row;
        float sum = 0.0;
        if (row < HIDDEN_SIZE) {
            for (
                uint word = gl_SubgroupInvocationID;
                word < INTERMEDIATE_FP8_WORDS;
                word += gl_SubgroupSize
            ) {
                uint block = word / BLOCK_FP8_WORDS;
                sum = fma(
                    fp8_dot4_acc32(
                        cached_intermediate[word],
                        read_weightx4(expert_output_weight, row, word * 4u),
                        0.0
                    ),
                    cached_intermediate_scales[block]
                        * read_scale(expert_output_scale_inv, row, block),
                    sum
                );
            }
        }
        sum = subgroupAdd(sum);
        if (gl_SubgroupInvocationID == 0u) {
            output_rows[local_row] = row < HIDDEN_SIZE
                ? round_bf16(round_bf16(sum) * route_weight)
                : 0.0;
        }
    }
    barrier();

    if (lane < TILE_ROWS / 2u) {
        uint row = first_row + lane * 2u;
        if (row < HIDDEN_SIZE) {
            uint hi = row + 1u < HIDDEN_SIZE
                ? f32_to_bf16(output_rows[lane * 2u + 1u])
                : 0u;
            expert_outputs.words[route * HIDDEN_WORDS + row / 2u] =
                (hi << 16u) | f32_to_bf16(output_rows[lane * 2u]);
        }
    }
}
