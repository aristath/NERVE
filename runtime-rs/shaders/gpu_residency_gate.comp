#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Selections {
    uint words[];
} selections;

layout(set = 0, binding = 1) readonly buffer AddressTable {
    uint words[];
} address_table;

layout(set = 0, binding = 2) readonly buffer ResourceGroups {
    uint words[];
} resource_groups;

layout(set = 0, binding = 3) readonly buffer ResourceAddressSlots {
    uint words[];
} resource_address_slots;

layout(set = 0, binding = 4) buffer ResolvedAddresses {
    uint words[];
} resolved_addresses;

layout(set = 0, binding = 5) buffer MissingRequests {
    uint words[];
} missing_requests;

layout(set = 0, binding = 6) buffer ContinuationPredicate {
    uint enabled;
} continuation;

layout(set = 0, binding = 7) readonly buffer GateConfiguration {
    uint words[];
} configuration;

layout(set = 0, binding = 8) buffer TransactionPredicate {
    uint enabled;
} transaction;

layout(push_constant) uniform GateControl {
    uint selection_count;
    uint checkpoint_tag;
    uint restore_downstream;
    uint restore_transaction;
} control;

const uint ADDRESS_RECORD_WORDS = 8u;
const uint GROUP_RECORD_WORDS = 2u;
const uint RESOLVED_HEADER_WORDS = 8u;
const uint RESOLVED_RECORD_WORDS = 8u;
const uint MISSING_HEADER_WORDS = 4u;
const uint MISSING_RECORD_WORDS = 2u;
const uint GROUP_TABLE_MAPPING = 0u;

uint selected_resource(uint selection_index) {
    uint lane = selection_index / configuration.words[5];
    uint lane_selection = selection_index % configuration.words[5];
    uint selection_word = lane * configuration.words[6] + lane_selection;
    return (selections.words[selection_word] >> configuration.words[0])
        & configuration.words[1];
}

uint seen_resource_word_count() {
    return (configuration.words[2] + 31u) / 32u;
}

uint seen_resource_word_offset() {
    return RESOLVED_HEADER_WORDS
        + configuration.words[4] * RESOLVED_RECORD_WORDS;
}

uint missing_resource_word_offset() {
    return seen_resource_word_offset() + seen_resource_word_count();
}

bool resource_is_owned(uint resource_index) {
    uint ownership_word_count = configuration.words[10];
    if (ownership_word_count == 0u) return true;
    uint ownership_word = resource_index / 32u;
    if (ownership_word >= ownership_word_count) return false;
    uint ownership_offset = configuration.words[9];
    uint ownership_bit = 1u << (resource_index % 32u);
    return (configuration.words[ownership_offset + ownership_word]
        & ownership_bit) != 0u;
}

bool address_slot_is_resident(uint slot) {
    uint record = slot * ADDRESS_RECORD_WORDS;
    uint address_nonzero = address_table.words[record]
        | address_table.words[record + 1u];
    uint byte_count_nonzero = address_table.words[record + 2u]
        | address_table.words[record + 3u];
    uint generation_nonzero = address_table.words[record + 4u]
        | address_table.words[record + 5u];
    return address_table.words[record + 6u] == 1u
        && address_nonzero != 0u
        && byte_count_nonzero != 0u
        && generation_nonzero != 0u;
}

uint resource_member_count(uint resource_index) {
    if (configuration.words[7] != GROUP_TABLE_MAPPING) {
        return configuration.words[8];
    }
    return resource_groups.words[
        resource_index * GROUP_RECORD_WORDS + 1u
    ];
}

uint resource_member_slot(
    uint resource_index,
    uint member_index
) {
    if (configuration.words[7] != GROUP_TABLE_MAPPING) {
        return resource_address_slots.words[member_index]
            + resource_index;
    }
    uint first_member = resource_groups.words[
        resource_index * GROUP_RECORD_WORDS
    ];
    return resource_address_slots.words[first_member + member_index];
}

void copy_resolved_address(
    uint resolved_index,
    uint resource_index,
    uint member_index,
    uint address_slot
) {
    uint source = address_slot * ADDRESS_RECORD_WORDS;
    uint destination = RESOLVED_HEADER_WORDS
        + resolved_index * RESOLVED_RECORD_WORDS;
    resolved_addresses.words[destination] = resource_index;
    resolved_addresses.words[destination + 1u] = member_index;
    resolved_addresses.words[destination + 2u] =
        address_table.words[source];
    resolved_addresses.words[destination + 3u] =
        address_table.words[source + 1u];
    resolved_addresses.words[destination + 4u] =
        address_table.words[source + 2u];
    resolved_addresses.words[destination + 5u] =
        address_table.words[source + 3u];
    resolved_addresses.words[destination + 6u] =
        address_table.words[source + 4u];
    resolved_addresses.words[destination + 7u] =
        address_table.words[source + 5u];
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    for (uint word = lane; word < RESOLVED_HEADER_WORDS; word += 64u) {
        resolved_addresses.words[word] = 0u;
    }
    for (
        uint word = lane;
        word < seen_resource_word_count();
        word += 64u
    ) {
        resolved_addresses.words[seen_resource_word_offset() + word] = 0u;
    }
    memoryBarrierBuffer();
    barrier();

    for (
        uint selection = lane;
        selection < control.selection_count;
        selection += 64u
    ) {
        uint resource_index = selected_resource(selection);
        if (resource_index >= configuration.words[2]) {
            atomicOr(resolved_addresses.words[4], 1u);
            continue;
        }
        if (!resource_is_owned(resource_index)) continue;
        uint seen_word = resource_index / 32u;
        uint seen_bit = 1u << (resource_index % 32u);
        uint previous_seen = atomicOr(
            resolved_addresses.words[
                seen_resource_word_offset() + seen_word
            ],
            seen_bit
        );
        if ((previous_seen & seen_bit) != 0u) continue;
        atomicAdd(resolved_addresses.words[1], 1u);

        uint member_count = resource_member_count(resource_index);
        bool resident = true;
        for (uint member = 0u; member < member_count; member += 1u) {
            uint slot = resource_member_slot(resource_index, member);
            resident = resident && address_slot_is_resident(slot);
        }
        if (!resident) {
            uint missing_index = atomicAdd(resolved_addresses.words[3], 1u);
            resolved_addresses.words[
                missing_resource_word_offset() + missing_index
            ] = resource_index;
            continue;
        }

        uint first_resolved = atomicAdd(
            resolved_addresses.words[2],
            member_count
        );
        for (uint member = 0u; member < member_count; member += 1u) {
            uint resolved_index = first_resolved + member;
            if (resolved_index >= configuration.words[4]) {
                atomicOr(resolved_addresses.words[4], 1u);
                break;
            }
            uint slot = resource_member_slot(resource_index, member);
            copy_resolved_address(
                resolved_index,
                resource_index,
                member,
                slot
            );
        }
    }

    memoryBarrierBuffer();
    barrier();
    if (lane != 0u) return;

    uint selected_count = resolved_addresses.words[1];
    uint resolved_count = resolved_addresses.words[2];
    uint missing_count = resolved_addresses.words[3];
    uint invalid_selection = resolved_addresses.words[4];
    uint published = missing_requests.words[0];
    uint consumed = missing_requests.words[1];
    uint pending = published - consumed;
    uint capacity = configuration.words[3];
    uint publishable = min(
        missing_count,
        capacity - min(pending, capacity)
    );
    for (uint missing = 0u; missing < publishable; missing += 1u) {
        uint queue_slot = (published + missing) % capacity;
        uint request = MISSING_HEADER_WORDS
            + queue_slot * MISSING_RECORD_WORDS;
        missing_requests.words[request] = control.checkpoint_tag;
        missing_requests.words[request + 1u] =
            resolved_addresses.words[missing_resource_word_offset() + missing];
    }
    if (publishable != missing_count) {
        missing_requests.words[2] = 1u;
    }

    bool all_resident = missing_count == 0u && invalid_selection == 0u;
    if (invalid_selection != 0u) {
        missing_requests.words[2] = 1u;
    }
    resolved_addresses.words[0] = all_resident ? 1u : 0u;
    resolved_addresses.words[1] = selected_count;
    resolved_addresses.words[2] = resolved_count;
    resolved_addresses.words[3] = missing_count;
    resolved_addresses.words[4] = invalid_selection;
    resolved_addresses.words[5] = control.checkpoint_tag;
    resolved_addresses.words[6] = 0u;
    resolved_addresses.words[7] = 0u;
    if (!all_resident) {
        continuation.enabled = 0u;
        transaction.enabled = 0u;
    } else if (control.restore_downstream != 0u) {
        continuation.enabled = 1u;
    }
    if (all_resident && control.restore_transaction != 0u) {
        transaction.enabled = 1u;
    }

    memoryBarrierBuffer();
    if (missing_count != 0u || invalid_selection != 0u) {
        missing_requests.words[0] = published + publishable;
        missing_requests.words[3] += 1u;
    }
}
