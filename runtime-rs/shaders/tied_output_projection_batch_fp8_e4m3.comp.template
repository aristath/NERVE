#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_spirv_intrinsics : require

spirv_instruction(
    extensions = ["SPV_VALVE_mixed_float_dot_product"],
    capabilities = [6915],
    id = 6918
)
float fp8_dot4_acc32(fe4m3vec4 a, fe4m3vec4 b, float accumulator);

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer NormalizedFrames {
    uint words[];
} normalized_frames;

layout(set = 0, binding = 1) readonly buffer ProjectionWeight {
    uint words[];
} projection_weight;

layout(set = 0, binding = 2) buffer BatchedLogits {
    float values[];
} batched_logits;

layout(set = 0, binding = 3) readonly buffer ProjectionWeightScaleInv {
    uint words[];
} projection_weight_scale_inv;

layout(push_constant) uniform BatchControl {
    uint batch_width;
} batch_control;

const uint BATCH_TILE_WIDTH = {{BATCH_TILE_WIDTH}}u;
const uint BLOCK_ROWS = {{BLOCK_ROWS}}u;
const uint BLOCK_COLUMNS = {{BLOCK_COLUMNS}}u;
const uint INPUT_SIZE = {{INPUT_SIZE}}u;
const uint VOCAB_SIZE = {{VOCAB_SIZE}}u;
const uint OUTPUT_TILE_ROWS = {{OUTPUT_TILE_ROWS}}u;
const uint INPUT_WORDS = INPUT_SIZE / 2u;
const uint INPUT_FP8_WORDS = INPUT_SIZE / 4u;
const uint INPUT_BLOCKS = INPUT_SIZE / BLOCK_COLUMNS;
const uint BLOCK_FP8_WORDS = BLOCK_COLUMNS / 4u;
const uint SCALE_COLUMNS = INPUT_BLOCKS;
const uint ROW_CLUSTER_LANES = 32u;
const float OUTPUT_SCALE = {{OUTPUT_SCALE}};

shared fe4m3vec4 quantized_input[BATCH_TILE_WIDTH][INPUT_FP8_WORDS];
shared float input_scales[BATCH_TILE_WIDTH][INPUT_BLOCKS];
shared float output_rows[BATCH_TILE_WIDTH][OUTPUT_TILE_ROWS];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16);
}

float read_bf16_word(uint packed, uint index) {
    return bf16_to_f32(packed >> ((index & 1u) * 16u));
}

vec4 read_inputx4(uint batch_index, uint column) {
    uint offset = batch_index * INPUT_WORDS + (column >> 1u);
    uint lo = normalized_frames.words[offset];
    uint hi = normalized_frames.words[offset + 1u];
    return vec4(
        bf16_to_f32(lo),
        bf16_to_f32(lo >> 16u),
        bf16_to_f32(hi),
        bf16_to_f32(hi >> 16u)
    );
}

float read_weight_scale(uint row, uint block) {
    uint index = (row / BLOCK_ROWS) * SCALE_COLUMNS + block;
    return read_bf16_word(projection_weight_scale_inv.words[index >> 1u], index);
}

fe4m3vec4 read_weightx4(uint row, uint column) {
    uint index = row * INPUT_SIZE + column;
    uint packed = projection_weight.words[index >> 2u];
    return uintBitsToFloate4m3EXT(u8vec4(
        uint8_t(packed),
        uint8_t(packed >> 8u),
        uint8_t(packed >> 16u),
        uint8_t(packed >> 24u)
    ));
}

void main() {
    uint batch_start = gl_WorkGroupID.y * BATCH_TILE_WIDTH;
    if (batch_start >= batch_control.batch_width) {
        return;
    }
    uint lane = gl_LocalInvocationID.x;
    uint cluster = lane >> 5u;
    uint cluster_lane = lane & 31u;
    uint input_tasks = BATCH_TILE_WIDTH * INPUT_BLOCKS;
    for (uint task = cluster; task < input_tasks; task += 32u) {
        uint batch_lane = task / INPUT_BLOCKS;
        uint block = task % INPUT_BLOCKS;
        uint batch_index = batch_start + batch_lane;
        uint word = block * BLOCK_FP8_WORDS + cluster_lane;
        vec4 input_value = batch_index < batch_control.batch_width
            ? read_inputx4(batch_index, word * 4u)
            : vec4(0.0);
        float lane_max = max(
            max(abs(input_value.x), abs(input_value.y)),
            max(abs(input_value.z), abs(input_value.w))
        );
        float block_max = subgroupClusteredMax(lane_max, 32u);
        float scale = block_max > 0.0 ? block_max / 448.0 : 1.0;
        if (cluster_lane == 0u) {
            input_scales[batch_lane][block] = scale;
        }
        quantized_input[batch_lane][word] = fe4m3vec4(input_value / scale);
    }
    barrier();

    uint first_row = gl_WorkGroupID.x * OUTPUT_TILE_ROWS;
    uint rows_per_subgroup = gl_SubgroupSize / ROW_CLUSTER_LANES;
    uint row_cluster = gl_SubgroupInvocationID / ROW_CLUSTER_LANES;
    uint row_lane = gl_SubgroupInvocationID & (ROW_CLUSTER_LANES - 1u);
    uint local_row = gl_SubgroupID * rows_per_subgroup + row_cluster;
    uint row = first_row + local_row;
    float sums[BATCH_TILE_WIDTH];
    for (uint batch_lane = 0u; batch_lane < BATCH_TILE_WIDTH; batch_lane++) {
        sums[batch_lane] = 0.0;
    }
    if (local_row < OUTPUT_TILE_ROWS && row < VOCAB_SIZE) {
        for (
            uint word = row_lane;
            word < INPUT_FP8_WORDS;
            word += ROW_CLUSTER_LANES
        ) {
            uint block = word / BLOCK_FP8_WORDS;
            fe4m3vec4 weight_value = read_weightx4(row, word * 4u);
            float weight_scale = read_weight_scale(row, block);
            for (uint batch_lane = 0u; batch_lane < BATCH_TILE_WIDTH; batch_lane++) {
                uint batch_index = batch_start + batch_lane;
                if (batch_index < batch_control.batch_width) {
                    sums[batch_lane] = fma(
                        fp8_dot4_acc32(
                            quantized_input[batch_lane][word],
                            weight_value,
                            0.0
                        ),
                        input_scales[batch_lane][block] * weight_scale,
                        sums[batch_lane]
                    );
                }
            }
        }
    }
    for (uint batch_lane = 0u; batch_lane < BATCH_TILE_WIDTH; batch_lane++) {
        sums[batch_lane] = subgroupClusteredAdd(
            sums[batch_lane],
            ROW_CLUSTER_LANES
        );
    }
    if (local_row < OUTPUT_TILE_ROWS && row_lane == 0u) {
        for (uint batch_lane = 0u; batch_lane < BATCH_TILE_WIDTH; batch_lane++) {
            output_rows[batch_lane][local_row] = sums[batch_lane];
        }
    }
    barrier();

    for (uint output_index = lane;
         output_index < BATCH_TILE_WIDTH * OUTPUT_TILE_ROWS;
         output_index += gl_WorkGroupSize.x) {
        uint batch_lane = output_index / OUTPUT_TILE_ROWS;
        uint local_output_row = output_index % OUTPUT_TILE_ROWS;
        uint batch_index = batch_start + batch_lane;
        uint row = first_row + local_output_row;
        if (batch_index >= batch_control.batch_width) {
            continue;
        }
        if (row < VOCAB_SIZE) {
            batched_logits.values[batch_index * VOCAB_SIZE + row] =
                output_rows[batch_lane][local_output_row] * OUTPUT_SCALE;
        }
    }
}
