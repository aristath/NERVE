#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = {{LOCAL_SIZE}}, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QueryFrames {
    uint words[];
} query_frames;

layout(set = 0, binding = 1) readonly buffer CurrentKFrames {
    uint words[];
} current_k_frames;

layout(set = 0, binding = 2) readonly buffer CurrentVFrames {
    uint words[];
} current_v_frames;

layout(set = 0, binding = 4) buffer OutputFrames {
    uint words[];
} output_frames;

#if {{HAS_SINKS}}
layout(set = 0, binding = {{ATTENTION_SINK_BINDING}}) readonly buffer AttentionSinks {
    uint words[];
} attention_sinks;
#endif

layout(set = 0, binding = {{STATE_READ_BINDING}}) readonly buffer KvStateRead {
    uint words[];
} kv_state_read;

layout(set = 0, binding = {{BATCH_CONTROL_BINDING}}) readonly buffer BatchControl {
    uint batch_width;
    uint start_stream_tick_low;
    uint start_stream_tick_high;
    uint dynamic_state_capacity;
} batch_control;

const uint QUERY_HEADS = {{QUERY_HEADS}}u;
const uint KV_HEADS = {{KV_HEADS}}u;
const uint QUERY_GROUPS_PER_KV_HEAD = {{QUERY_GROUPS_PER_KV_HEAD}}u;
const uint HEAD_WIDTH = {{HEAD_WIDTH}}u;
const uint QUERY_ELEMENT_COUNT = QUERY_HEADS * HEAD_WIDTH;
const uint QUERY_WORD_COUNT = QUERY_ELEMENT_COUNT / 2u;
const uint KV_ELEMENT_COUNT = KV_HEADS * HEAD_WIDTH;
const uint KV_WORD_COUNT = KV_ELEMENT_COUNT / 2u;
const uint SLOT_ELEMENT_COUNT = KV_ELEMENT_COUNT * 2u;
const uint SLOT_WORD_COUNT = KV_WORD_COUNT * 2u;
const uint TILE_TOKENS = {{TILE_TOKENS}}u;
const uint TILE_REDUCTION_WIDTH = {{TILE_REDUCTION_WIDTH}}u;
const uint PADDED_HEAD_WIDTH = ((HEAD_WIDTH + 63u) / 64u) * 64u;
const uint PHYSICAL_TILE_TOKENS = {{LOCAL_SIZE}}u / PADDED_HEAD_WIDTH;
const uint TOKEN_BATCHES = TILE_TOKENS / PHYSICAL_TILE_TOKENS;
const uint MAX_SUBGROUPS_PER_TOKEN = (HEAD_WIDTH + 31u) / 32u;
const float ATTENTION_SCALE = {{ATTENTION_SCALE}};
const uint ATTENTION_WINDOW = {{ATTENTION_WINDOW}}u;
const float LOWEST_FLOAT = -3.4028234663852886e38;
const uint STATE_PAGE_TABLE_WORDS = 9u;

shared float query_values[{{HEAD_WIDTH}}];
shared float subgroup_partials[{{TILE_TOKENS}} * MAX_SUBGROUPS_PER_TOKEN];
shared float tile_scores[{{TILE_TOKENS}}];
shared float tile_reduction[{{TILE_REDUCTION_WIDTH}}];
shared float tile_value_weight[{{TILE_TOKENS}}];
shared float value_contributions[{{TILE_TOKENS}} * {{HEAD_WIDTH}}];
shared float tile_accumulator_carry;
shared float tile_value_scale;
shared float softmax_denominator;
shared float attention_output_scale;
shared float output_values[{{HEAD_WIDTH}}];
shared uint tile_read_word_base[{{TILE_TOKENS}}];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7fffu + lsb) >> 16;
}

float read_packed_bf16(uint packed, uint element_index) {
    uint value = ((element_index & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16);
    return bf16_to_f32(value);
}

uint kv_state_read_word(uint logical_word) {
    uint logical_byte = logical_word * 4u;
    uint static_bytes = kv_state_read.words[2];
    if (logical_byte < static_bytes) {
        return (kv_state_read.words[3] + logical_byte) / 4u;
    }
    uint dynamic_byte = logical_byte - static_bytes;
    uint page_bytes = kv_state_read.words[4];
    uint logical_page = dynamic_byte / page_bytes;
    uint physical_page = kv_state_read.words[STATE_PAGE_TABLE_WORDS + logical_page];
    return (
        kv_state_read.words[8]
        + physical_page * page_bytes
        + dynamic_byte % page_bytes
    ) / 4u;
}

float read_query(uint position, uint index) {
    uint element_index = position * QUERY_ELEMENT_COUNT + index;
    return read_packed_bf16(query_frames.words[element_index >> 1], element_index);
}

float read_current_k(uint position, uint kv_head, uint dim) {
    uint element_index =
        position * KV_ELEMENT_COUNT + kv_head * HEAD_WIDTH + dim;
    return read_packed_bf16(current_k_frames.words[element_index >> 1], element_index);
}

float read_current_v(uint position, uint kv_head, uint dim) {
    uint element_index =
        position * KV_ELEMENT_COUNT + kv_head * HEAD_WIDTH + dim;
    return read_packed_bf16(current_v_frames.words[element_index >> 1], element_index);
}

float read_k(
    uint absolute_tick,
    uint physical_word_base,
    uint kv_head,
    uint dim
) {
    if (absolute_tick >= batch_control.start_stream_tick_low) {
        return read_current_k(
            absolute_tick - batch_control.start_stream_tick_low,
            kv_head,
            dim
        );
    }
    uint element_index = kv_head * HEAD_WIDTH + dim;
    return read_packed_bf16(
        kv_state_read.words[physical_word_base + (element_index >> 1)],
        element_index
    );
}

float read_v(
    uint absolute_tick,
    uint physical_word_base,
    uint kv_head,
    uint dim
) {
    if (absolute_tick >= batch_control.start_stream_tick_low) {
        return read_current_v(
            absolute_tick - batch_control.start_stream_tick_low,
            kv_head,
            dim
        );
    }
    uint element_index = kv_head * HEAD_WIDTH + dim;
    return read_packed_bf16(
        kv_state_read.words[
            physical_word_base + KV_WORD_COUNT + (element_index >> 1)
        ],
        element_index
    );
}

#if {{HAS_SINKS}}
float read_attention_sink(uint head) {
    uint packed = attention_sinks.words[head >> 1u];
    return bf16_to_f32((head & 1u) == 0u ? packed : packed >> 16);
}
#endif

void main() {
    uint query_head = gl_WorkGroupID.x % QUERY_HEADS;
    uint position = gl_WorkGroupID.x / QUERY_HEADS;
    uint local_index = gl_LocalInvocationID.x;
    uint subgroups_per_token = (HEAD_WIDTH + gl_SubgroupSize - 1u) / gl_SubgroupSize;
    uint tile_entry = gl_SubgroupID / subgroups_per_token;
    uint subgroup_part = gl_SubgroupID % subgroups_per_token;
    uint dim = subgroup_part * gl_SubgroupSize + gl_SubgroupInvocationID;
    if (position >= batch_control.batch_width) return;

    uint capacity = ATTENTION_WINDOW == 0u
        ? batch_control.dynamic_state_capacity
        : min(batch_control.dynamic_state_capacity, ATTENTION_WINDOW);
    uint kv_head = query_head / QUERY_GROUPS_PER_KV_HEAD;
    {
        uint stream_tick = batch_control.start_stream_tick_low + position;
        uint tokens = capacity == 0u ? 0u : min(stream_tick + 1u, capacity);
        uint oldest_tick = stream_tick + 1u - tokens;

        if (local_index < HEAD_WIDTH) {
            query_values[local_index] = read_query(
                position,
                query_head * HEAD_WIDTH + local_index
            );
        }
        barrier();

        float maximum = LOWEST_FLOAT;
        float denominator = 0.0;
        float accumulator = 0.0;
        for (uint tile_start = 0u; tile_start < tokens; tile_start += TILE_TOKENS) {
            uint tile_count = min(TILE_TOKENS, tokens - tile_start);
            if (local_index < tile_count) {
                uint absolute_tick = oldest_tick + tile_start + local_index;
                tile_read_word_base[local_index] =
                    absolute_tick >= batch_control.start_stream_tick_low
                    ? 0u
                    : kv_state_read_word(
                        (absolute_tick % capacity) * SLOT_WORD_COUNT
                    );
            }
            barrier();

            for (uint batch = 0u; batch < TOKEN_BATCHES; batch++) {
                uint tile_token = batch * PHYSICAL_TILE_TOKENS + tile_entry;
                uint token_index = tile_start + tile_token;
                float product = 0.0;
                if (
                    tile_entry < PHYSICAL_TILE_TOKENS
                    && token_index < tokens
                    && dim < HEAD_WIDTH
                ) {
                    product = query_values[dim]
                        * read_k(
                            oldest_tick + token_index,
                            tile_read_word_base[tile_token],
                            kv_head,
                            dim
                        );
                }
                float partial = subgroupAdd(product);
                if (
                    gl_SubgroupInvocationID == 0u
                    && tile_entry < PHYSICAL_TILE_TOKENS
                ) {
                    subgroup_partials[
                        tile_token * subgroups_per_token + subgroup_part
                    ] = partial;
                }
            }
            barrier();

            if (local_index < TILE_REDUCTION_WIDTH) {
                if (local_index < tile_count) {
                    float dot_product = 0.0;
                    for (uint part = 0u; part < subgroups_per_token; part++) {
                        dot_product += subgroup_partials[
                            local_index * subgroups_per_token + part
                        ];
                    }
                    tile_scores[local_index] = dot_product * ATTENTION_SCALE;
                    tile_reduction[local_index] = tile_scores[local_index];
                } else {
                    tile_reduction[local_index] = LOWEST_FLOAT;
                }
            }
            barrier();
            for (uint stride = TILE_REDUCTION_WIDTH / 2u; stride > 0u; stride >>= 1u) {
                if (local_index < stride) {
                    tile_reduction[local_index] = max(
                        tile_reduction[local_index],
                        tile_reduction[local_index + stride]
                    );
                }
                barrier();
            }
            float tile_maximum = tile_reduction[0];
            if (local_index < TILE_REDUCTION_WIDTH) {
                float weight = local_index < tile_count
                    ? exp(tile_scores[local_index] - tile_maximum)
                    : 0.0;
                if (local_index < tile_count) {
                    tile_value_weight[local_index] = weight;
                }
                tile_reduction[local_index] = weight;
            }
            barrier();
            for (uint stride = TILE_REDUCTION_WIDTH / 2u; stride > 0u; stride >>= 1u) {
                if (local_index < stride) {
                    tile_reduction[local_index] += tile_reduction[local_index + stride];
                }
                barrier();
            }
            if (local_index == 0u) {
                float next_maximum = max(maximum, tile_maximum);
                float old_scale = exp(maximum - next_maximum);
                tile_value_scale = exp(tile_maximum - next_maximum);
                denominator =
                    denominator * old_scale + tile_reduction[0] * tile_value_scale;
                maximum = next_maximum;
                tile_accumulator_carry = old_scale;
            }
            barrier();

            for (uint batch = 0u; batch < TOKEN_BATCHES; batch++) {
                uint contribution_index =
                    batch * PHYSICAL_TILE_TOKENS * HEAD_WIDTH + local_index;
                uint tile_token =
                    batch * PHYSICAL_TILE_TOKENS + local_index / HEAD_WIDTH;
                uint token_index = tile_start + tile_token;
                uint value_dim = local_index % HEAD_WIDTH;
                if (
                    local_index < PHYSICAL_TILE_TOKENS * HEAD_WIDTH
                    && token_index < tokens
                ) {
                    value_contributions[contribution_index] =
                        tile_value_weight[tile_token] * tile_value_scale
                        * read_v(
                            oldest_tick + token_index,
                            tile_read_word_base[tile_token],
                            kv_head,
                            value_dim
                        );
                } else if (local_index < PHYSICAL_TILE_TOKENS * HEAD_WIDTH) {
                    value_contributions[contribution_index] = 0.0;
                }
            }
            barrier();

            if (local_index < HEAD_WIDTH) {
                float tile_sum = 0.0;
                for (uint index = 0u; index < tile_count; index++) {
                    tile_sum += value_contributions[
                        index * HEAD_WIDTH + local_index
                    ];
                }
                accumulator = accumulator * tile_accumulator_carry + tile_sum;
            }
            barrier();
        }

        if (local_index == 0u) {
            softmax_denominator = denominator;
#if {{HAS_SINKS}}
            float logsumexp = maximum + log(denominator);
            attention_output_scale = denominator == 0.0
                ? 0.0
                : 1.0 / (1.0 + exp(read_attention_sink(query_head) - logsumexp));
#else
            attention_output_scale = 1.0;
#endif
        }
        barrier();

        if (local_index < HEAD_WIDTH) {
            output_values[local_index] = tokens == 0u || softmax_denominator == 0.0
                ? 0.0
                : (accumulator / softmax_denominator) * attention_output_scale;
        }
        barrier();

        if (local_index < HEAD_WIDTH && (local_index & 1u) == 0u) {
            uint word_index = position * QUERY_WORD_COUNT
                + query_head * (HEAD_WIDTH / 2u)
                + local_index / 2u;
            output_frames.words[word_index] =
                (f32_to_bf16(output_values[local_index + 1u]) << 16)
                | f32_to_bf16(output_values[local_index]);
        }
        barrier();
    }
}
