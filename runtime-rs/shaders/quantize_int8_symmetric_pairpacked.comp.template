#version 460

#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputFrame { uint words[]; } input_frame;
layout(set = 0, binding = 1) buffer QuantizedFrame { uint words[]; } quantized_frame;
layout(set = 0, binding = 2) buffer Scale { float values[]; } scale;
layout(set = 0, binding = 3) buffer BlockSum { int values[]; } block_sum;

const uint BLOCK_COLUMNS = {{BLOCK_COLUMNS}}u;
const uint ELEMENT_COUNT = {{ELEMENT_COUNT}}u;
const uint PAIRS_PER_BLOCK = BLOCK_COLUMNS / 8u;
const uint WORDS_PER_BLOCK = BLOCK_COLUMNS / 4u;

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16u);
}

uint pack_i8x4(ivec4 value) {
    return (uint(value.x) & 255u)
        | ((uint(value.y) & 255u) << 8u)
        | ((uint(value.z) & 255u) << 16u)
        | ((uint(value.w) & 255u) << 24u);
}

void main() {
    uint block = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    uint column = block * BLOCK_COLUMNS + lane * 8u;
    vec4 even_values = vec4(0.0);
    vec4 odd_values = vec4(0.0);
    if (lane < PAIRS_PER_BLOCK && column < ELEMENT_COUNT) {
        uint word = column >> 1u;
        uint first = input_frame.words[word];
        uint second = input_frame.words[word + 1u];
        uint third = input_frame.words[word + 2u];
        uint fourth = input_frame.words[word + 3u];
        even_values = vec4(
            bf16_to_f32(first),
            bf16_to_f32(second),
            bf16_to_f32(third),
            bf16_to_f32(fourth)
        );
        odd_values = vec4(
            bf16_to_f32(first >> 16u),
            bf16_to_f32(second >> 16u),
            bf16_to_f32(third >> 16u),
            bf16_to_f32(fourth >> 16u)
        );
    }
    float lane_max = max(
        max(
            max(abs(even_values.x), abs(even_values.y)),
            max(abs(even_values.z), abs(even_values.w))
        ),
        max(
            max(abs(odd_values.x), abs(odd_values.y)),
            max(abs(odd_values.z), abs(odd_values.w))
        )
    );
    float block_max = subgroupMax(lane_max);
    float block_scale = block_max > 0.0 ? block_max / 127.0 : 1.0;
    ivec4 quantized_even = ivec4(
        round(clamp(even_values / block_scale, -127.0, 127.0))
    );
    ivec4 quantized_odd = ivec4(
        round(clamp(odd_values / block_scale, -127.0, 127.0))
    );
    int lane_sum = quantized_even.x + quantized_even.y
        + quantized_even.z + quantized_even.w
        + quantized_odd.x + quantized_odd.y
        + quantized_odd.z + quantized_odd.w;
    int sum = subgroupAdd(lane_sum);
    if (lane == 0u) {
        scale.values[block] = block_scale;
        block_sum.values[block] = sum;
    }
    if (lane < PAIRS_PER_BLOCK && column < ELEMENT_COUNT) {
        uint output_word = block * WORDS_PER_BLOCK + lane * 2u;
        quantized_frame.words[output_word] = pack_i8x4(quantized_even);
        quantized_frame.words[output_word + 1u] = pack_i8x4(quantized_odd);
    }
}
