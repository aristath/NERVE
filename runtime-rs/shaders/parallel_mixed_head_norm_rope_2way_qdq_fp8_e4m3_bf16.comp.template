#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_float_e4m3 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QueryInput { uint words[]; } query_input;
layout(set = 0, binding = 1) readonly buffer KeyValueInput { uint words[]; } key_value_input;
layout(set = 0, binding = 2) buffer QueryOutput { uint words[]; } query_output;
layout(set = 0, binding = 3) buffer KeyValueOutput { uint words[]; } key_value_output;
layout(set = 0, binding = 4) readonly buffer KeyValueWeight { uint words[]; } key_value_weight;
layout(set = 0, binding = 5) readonly buffer StreamControl { uint words[]; } stream_control;

const uint QUERY_HEADS = {{QUERY_HEADS}}u;
const uint KEY_VALUE_HEADS = {{KEY_VALUE_HEADS}}u;
const uint HEAD_WIDTH = {{HEAD_WIDTH}}u;
const uint ROTARY_WIDTH = {{ROTARY_WIDTH}}u;
const uint ROTARY_OFFSET = HEAD_WIDTH - ROTARY_WIDTH;
const uint QUANT_BLOCK_COLUMNS = {{QUANT_BLOCK_COLUMNS}}u;
const uint QUANT_BLOCK_COUNT = ROTARY_OFFSET / QUANT_BLOCK_COLUMNS;
const float QUERY_NORM_EPS = {{QUERY_NORM_EPS}};
const float KEY_VALUE_NORM_EPS = {{KEY_VALUE_NORM_EPS}};
const float KEY_VALUE_WEIGHT_OFFSET = {{KEY_VALUE_WEIGHT_OFFSET}};
const float ROPE_THETA = {{ROPE_THETA}};
const bool ROPE_INTERLEAVED = {{ROPE_INTERLEAVED}};
const bool ROPE_YARN = {{ROPE_YARN}};
const float ROPE_FACTOR = {{ROPE_FACTOR}};
const float ROPE_CORRECTION_LOW = {{ROPE_CORRECTION_LOW}};
const float ROPE_CORRECTION_HIGH = {{ROPE_CORRECTION_HIGH}};
const float ROPE_ATTENTION_FACTOR = {{ROPE_ATTENTION_FACTOR}};
const int POSITION_OFFSET = {{POSITION_OFFSET}};

shared float reduction[64];
shared uint normalized_words[(HEAD_WIDTH + 1u) / 2u];
shared float output_values[HEAD_WIDTH];
shared float block_scales[QUANT_BLOCK_COUNT];

float bf16_to_f32(uint value) {
    return uintBitsToFloat((value & 0xffffu) << 16u);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7fffu + lsb) >> 16u;
}

float round_bf16(float value) {
    return bf16_to_f32(f32_to_bf16(value));
}

float read_input(uint branch, uint index) {
    uint packed = branch == 0u
        ? query_input.words[index >> 1u]
        : key_value_input.words[index >> 1u];
    uint value = ((index & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16u);
    return bf16_to_f32(value);
}

float read_key_value_weight(uint index) {
    uint packed = key_value_weight.words[index >> 1u];
    uint value = ((index & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16u);
    return bf16_to_f32(value);
}

float read_normalized(uint dim) {
    uint packed = normalized_words[dim >> 1u];
    uint value = ((dim & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16u);
    return bf16_to_f32(value);
}

float rotate_value(uint dim) {
    uint rotary_dim = dim - ROTARY_OFFSET;
    if (ROPE_INTERLEAVED) {
        return (rotary_dim & 1u) == 0u
            ? -read_normalized(ROTARY_OFFSET + rotary_dim + 1u)
            : read_normalized(ROTARY_OFFSET + rotary_dim - 1u);
    }
    return rotary_dim < (ROTARY_WIDTH / 2u)
        ? -read_normalized(ROTARY_OFFSET + rotary_dim + (ROTARY_WIDTH / 2u))
        : read_normalized(ROTARY_OFFSET + rotary_dim - (ROTARY_WIDTH / 2u));
}

float rope_inverse_frequency(uint frequency_index) {
    float inverse_frequency = pow(
        ROPE_THETA,
        -2.0 * float(frequency_index) / float(ROTARY_WIDTH)
    );
    if (!ROPE_YARN) return inverse_frequency;
    float ramp = clamp(
        (float(frequency_index) - ROPE_CORRECTION_LOW)
            / (ROPE_CORRECTION_HIGH - ROPE_CORRECTION_LOW),
        0.0,
        1.0
    );
    return mix(inverse_frequency, inverse_frequency / ROPE_FACTOR, ramp);
}

float rotate(uint dim) {
    if (dim < ROTARY_OFFSET) return read_normalized(dim);
    uint rotary_dim = dim - ROTARY_OFFSET;
    uint frequency_index = ROPE_INTERLEAVED
        ? rotary_dim / 2u
        : rotary_dim % (ROTARY_WIDTH / 2u);
    float angle = (float(stream_control.words[1]) + float(POSITION_OFFSET))
        * rope_inverse_frequency(frequency_index);
    float cosine = round_bf16(cos(angle) * ROPE_ATTENTION_FACTOR);
    float sine = round_bf16(sin(angle) * ROPE_ATTENTION_FACTOR);
    float direct = round_bf16(read_normalized(dim) * cosine);
    float rotated = round_bf16(rotate_value(dim) * sine);
    return round_bf16(direct + rotated);
}

float quantize_dequantize_e4m3(float value, float scale) {
    fe4m3vec4 quantized = fe4m3vec4(vec4(clamp(value / scale, -448.0, 448.0)));
    u8vec4 bits = floate4m3BitsToUintEXT(quantized);
    vec4 restored = vec4(uintBitsToFloate4m3EXT(bits));
    return restored.x * scale;
}

void main() {
    uint global_head = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (global_head >= QUERY_HEADS + KEY_VALUE_HEADS) return;

    uint branch = global_head < QUERY_HEADS ? 0u : 1u;
    uint head = branch == 0u ? global_head : global_head - QUERY_HEADS;
    uint base = head * HEAD_WIDTH;
    float sum_squares = 0.0;
    for (uint dim = lane; dim < HEAD_WIDTH; dim += 64u) {
        float value = read_input(branch, base + dim);
        sum_squares = fma(value, value, sum_squares);
    }
    sum_squares = subgroupAdd(sum_squares);
    if (gl_SubgroupInvocationID == 0u) reduction[gl_SubgroupID] = sum_squares;
    barrier();
    sum_squares = 0.0;
    for (uint subgroup = 0u; subgroup < gl_NumSubgroups; subgroup++) {
        sum_squares += reduction[subgroup];
    }
    float epsilon = branch == 0u ? QUERY_NORM_EPS : KEY_VALUE_NORM_EPS;
    float inv_rms = inversesqrt((sum_squares / float(HEAD_WIDTH)) + epsilon);

    for (uint dim = lane * 2u; dim < HEAD_WIDTH; dim += 128u) {
        float lo = read_input(branch, base + dim) * inv_rms;
        float hi = read_input(branch, base + dim + 1u) * inv_rms;
        if (branch == 1u) {
            lo *= read_key_value_weight(dim) + KEY_VALUE_WEIGHT_OFFSET;
            hi *= read_key_value_weight(dim + 1u) + KEY_VALUE_WEIGHT_OFFSET;
        }
        normalized_words[dim >> 1u] =
            (f32_to_bf16(hi) << 16u) | f32_to_bf16(lo);
    }
    barrier();

    if (branch == 0u) {
        for (uint dim = lane * 2u; dim < HEAD_WIDTH; dim += 128u) {
            float lo = rotate(dim);
            float hi = rotate(dim + 1u);
            query_output.words[(base + dim) >> 1u] =
                (f32_to_bf16(hi) << 16u) | f32_to_bf16(lo);
        }
        return;
    }

    for (uint dim = lane; dim < HEAD_WIDTH; dim += 64u) {
        output_values[dim] = rotate(dim);
    }
    barrier();
    for (uint block = lane; block < QUANT_BLOCK_COUNT; block += 64u) {
        float maximum = 0.0;
        uint begin = block * QUANT_BLOCK_COLUMNS;
        for (uint offset = 0u; offset < QUANT_BLOCK_COLUMNS; ++offset) {
            maximum = max(maximum, abs(output_values[begin + offset]));
        }
        block_scales[block] = {{DYNAMIC_SCALE}};
    }
    barrier();
    for (uint dim = lane; dim < ROTARY_OFFSET; dim += 64u) {
        float scale = block_scales[dim / QUANT_BLOCK_COLUMNS];
        output_values[dim] = round_bf16(
            quantize_dequantize_e4m3(output_values[dim], scale)
        );
    }
    barrier();
    for (uint dim = lane * 2u; dim < HEAD_WIDTH; dim += 128u) {
        key_value_output.words[dim >> 1u] =
            (f32_to_bf16(output_values[dim + 1u]) << 16u)
            | f32_to_bf16(output_values[dim]);
    }
}
