#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) readonly buffer InputFrames { uint words[]; } input_frames;
layout(set = 0, binding = 1) buffer OutputFrames { uint words[]; } output_frames;
layout(set = 0, binding = 2) readonly buffer Weight { uint words[]; } weight;

const uint BLOCK_WIDTH = {{BLOCK_WIDTH}}u;
const uint HIDDEN_SIZE = {{HIDDEN_SIZE}}u;
const uint FRAME_WORDS = HIDDEN_SIZE / 2u;
const float NORM_EPS = {{NORM_EPS}};
const float WEIGHT_OFFSET = {{WEIGHT_OFFSET}};
shared float reduction[64];

float bf16_to_f32(uint value) { return uintBitsToFloat((value & 0xffffu) << 16u); }
uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7fffu + lsb) >> 16u;
}
float read_half(uint packed, uint half_index) {
    return bf16_to_f32(half_index == 0u ? packed : packed >> 16u);
}

void main() {
    uint position = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (position >= BLOCK_WIDTH) return;
    uint frame_offset = position * FRAME_WORDS;
    float squares = 0.0;
    for (uint word = lane; word < FRAME_WORDS; word += 64u) {
        uint packed = input_frames.words[frame_offset + word];
        float lo = read_half(packed, 0u);
        float hi = read_half(packed, 1u);
        squares = fma(lo, lo, squares);
        squares = fma(hi, hi, squares);
    }
    squares = subgroupAdd(squares);
    if (gl_SubgroupInvocationID == 0u) reduction[gl_SubgroupID] = squares;
    barrier();
    float total = 0.0;
    for (uint subgroup = 0u; subgroup < gl_NumSubgroups; subgroup++) total += reduction[subgroup];
    float inv_rms = inversesqrt(total / float(HIDDEN_SIZE) + NORM_EPS);
    for (uint word = lane; word < FRAME_WORDS; word += 64u) {
        uint input_pair = input_frames.words[frame_offset + word];
        uint weight_pair = weight.words[word];
        float lo = read_half(input_pair, 0u) * inv_rms * (read_half(weight_pair, 0u) + WEIGHT_OFFSET);
        float hi = read_half(input_pair, 1u) * inv_rms * (read_half(weight_pair, 1u) + WEIGHT_OFFSET);
        output_frames.words[frame_offset + word] = (f32_to_bf16(hi) << 16u) | f32_to_bf16(lo);
    }
}
