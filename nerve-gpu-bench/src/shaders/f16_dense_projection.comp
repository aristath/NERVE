#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 64) in;
layout(push_constant) uniform Params {
    uint elements;
} params;
layout(std430, binding = 0) buffer Data {
    uint packed_values[];
} data;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.elements) {
        return;
    }
    f16vec2 values = f16vec2(unpackHalf2x16(data.packed_values[index]));
    values = values * f16vec2(float16_t(1.001), float16_t(0.999))
        + f16vec2(float16_t(0.125), float16_t(0.0625));
    data.packed_values[index] = packHalf2x16(vec2(values));
}
