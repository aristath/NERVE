#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform Params {
    uint m;
    uint n;
    uint k;
    uint a_offset;
    uint b_offset;
    uint c_offset;
    uint logical_per_word;
    uint format_kind;
} params;
layout(std430, binding = 0) buffer Data {
    uint words[];
} data;

float activation_at(uint logical_index) {
    uint packed = data.words[params.a_offset + (logical_index >> 1u)];
    return uintBitsToFloat(((packed >> ((logical_index & 1u) * 16u)) & 0xffffu) << 16u);
}

float16_t weight_at(uint output_row, uint input_column) {
    uint logical_index = output_row * params.k + input_column;
    uint word = data.words[params.b_offset + logical_index / 2u];
    vec2 values = unpackHalf2x16(word);
    return float16_t(values[logical_index & 1u]);
}

uint f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    return (bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u;
}

void main() {
    uint first_col = gl_GlobalInvocationID.x * 2u;
    uint row = gl_GlobalInvocationID.y;
    if (row >= params.m || first_col >= params.n) {
        return;
    }

    float16_t accum0 = float16_t(0.0);
    float16_t accum1 = float16_t(0.0);
    for (uint kk = 0u; kk < params.k; kk++) {
        float16_t a = float16_t(activation_at(row * params.k + kk));
        accum0 += a * weight_at(first_col, kk);
        if (first_col + 1u < params.n) {
            accum1 += a * weight_at(first_col + 1u, kk);
        }
    }
    data.words[params.c_offset + (row * params.n + first_col) / 2u] =
        f32_to_bf16(float(accum0)) | (f32_to_bf16(float(accum1)) << 16u);
}
