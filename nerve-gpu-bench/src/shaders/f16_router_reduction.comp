#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 64) in;
layout(push_constant) uniform Params {
    uint elements;
} params;
layout(std430, binding = 0) buffer Data {
    uint packed_values[];
} data;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.elements) {
        return;
    }
    f16vec2 values = f16vec2(unpackHalf2x16(data.packed_values[index]));
    f16vec2 neighbor = f16vec2(unpackHalf2x16(data.packed_values[(index * 17u + 13u) % params.elements]));
    f16vec2 score = max(values, neighbor);
    f16vec2 normalized = score / (f16vec2(float16_t(1.0)) + abs(values - neighbor));
    values = normalized * f16vec2(float16_t(0.5)) + score * f16vec2(float16_t(0.5));
    data.packed_values[index] = packHalf2x16(vec2(values));
}
