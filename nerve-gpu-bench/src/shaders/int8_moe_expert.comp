#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 64) in;
layout(push_constant) uniform Params {
    uint elements;
} params;
layout(std430, binding = 0) buffer Data {
    uint packed_values[];
} data;

uint8_t lane(uint value, uint shift) {
    return uint8_t((value >> shift) & 0xffu);
}

uint8_t mix_lane(uint8_t value, uint8_t salt) {
    uint8_t gate = value > salt ? value : salt;
    return value * uint8_t(3) + gate * uint8_t(2) + salt;
}

uint pack_lanes(uint8_t a, uint8_t b, uint8_t c, uint8_t d) {
    return uint(a) | (uint(b) << 8) | (uint(c) << 16) | (uint(d) << 24);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.elements) {
        return;
    }
    uint value = data.packed_values[index];
    uint8_t a = mix_lane(lane(value, 0u), uint8_t(13));
    uint8_t b = mix_lane(lane(value, 8u), uint8_t(31));
    uint8_t c = mix_lane(lane(value, 16u), uint8_t(47));
    uint8_t d = mix_lane(lane(value, 24u), uint8_t(61));
    data.packed_values[index] = pack_lanes(a, b, c, d);
}
