#version 450

layout(local_size_x = 64) in;
layout(push_constant) uniform Params {
    uint elements;
} params;
layout(std430, binding = 0) buffer Data {
    uint values[];
} data;

uint mix_word(uint value, uint salt) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= salt;
    return value ^ (value >> 16);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.elements) {
        return;
    }
    uint x = data.values[index];
    uint gate = max(x & 0x00ff00ffu, (x >> 8) & 0x00ff00ffu);
    uint hidden = mix_word(x + gate + index, 0x846ca68bu);
    data.values[index] = hidden ^ ((gate << 7) | (gate >> 25));
}
