#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform Params {
    uint m;
    uint local_n;
    uint k;
    uint global_n;
    uint output_column_offset;
    uint logical_per_word;
    uint format_kind;
    uint scale_offset;
    uint group_size;
} params;
layout(std430, binding = 0) readonly buffer Activations {
    uint words[];
} activations;
layout(std430, binding = 1) readonly buffer Weights {
    uint words[];
} weights;
layout(std430, binding = 2) writeonly buffer Outputs {
    uint words[];
} outputs;

float bf16_lane(uint value, uint lane) {
    return uintBitsToFloat(((value >> ((lane & 1u) * 16u)) & 0xffffu) << 16u);
}

float fp8_lane(uint value, uint lane, uint exponent_bits, uint mantissa_bits, int bias) {
    uint byte_value = (value >> ((lane & 3u) * 8u)) & 0xffu;
    float sign_value = (byte_value & 0x80u) != 0u ? -1.0 : 1.0;
    uint exponent_mask = (1u << exponent_bits) - 1u;
    uint mantissa_mask = (1u << mantissa_bits) - 1u;
    uint exponent = (byte_value >> mantissa_bits) & exponent_mask;
    uint mantissa = byte_value & mantissa_mask;
    if (exponent == 0u) {
        return sign_value * float(mantissa) / float(1u << mantissa_bits)
            * exp2(float(1 - bias));
    }
    return sign_value * (1.0 + float(mantissa) / float(1u << mantissa_bits))
        * exp2(float(int(exponent) - bias));
}

float e2m1_lane(uint value, uint lane) {
    uint nibble = (value >> ((lane & 7u) * 4u)) & 0x0fu;
    uint magnitude = nibble & 7u;
    float decoded = magnitude == 0u ? 0.0
        : magnitude == 1u ? 0.5
        : magnitude == 2u ? 1.0
        : magnitude == 3u ? 1.5
        : magnitude == 4u ? 2.0
        : magnitude == 5u ? 3.0
        : magnitude == 6u ? 4.0
        : 6.0;
    return (nibble & 8u) != 0u ? -decoded : decoded;
}

float bf16_scale(uint index) {
    uint packed = weights.words[params.scale_offset + (index >> 1u)];
    return bf16_lane(packed, index);
}

float e8m0_scale(uint index) {
    uint packed = weights.words[params.scale_offset + (index >> 2u)];
    uint scale_byte = (packed >> ((index & 3u) * 8u)) & 0xffu;
    return scale_byte == 0u
        ? uintBitsToFloat(0x00400000u)
        : uintBitsToFloat(scale_byte << 23u);
}

float q8_0_weight(uint output_row, uint input_column) {
    uint blocks_per_row = (params.k + 31u) / 32u;
    uint block = output_row * blocks_per_row + input_column / 32u;
    uint block_offset = block * 9u;
    float scale = bf16_lane(weights.words[block_offset], 0u);
    uint byte_index = input_column & 31u;
    uint packed = weights.words[block_offset + 1u + (byte_index >> 2u)];
    uint byte_value = (packed >> ((byte_index & 3u) * 8u)) & 0xffu;
    int quantized = int(byte_value << 24u) >> 24;
    return float(quantized) * scale;
}

float weight_at(uint output_row, uint input_column) {
    if (params.format_kind == 18u) {
        return q8_0_weight(output_row, input_column);
    }
    uint logical_index = output_row * params.k + input_column;
    uint word_index = logical_index / params.logical_per_word;
    uint lane = logical_index - word_index * params.logical_per_word;
    uint packed = weights.words[word_index];
    if (params.format_kind == 0u) {
        return uintBitsToFloat(packed);
    }
    if (params.format_kind == 17u) {
        return unpackHalf2x16(packed)[lane & 1u];
    }
    if (params.format_kind == 1u) {
        return bf16_lane(packed, lane);
    }
    if (params.format_kind == 2u || params.format_kind == 3u) {
        float value = params.format_kind == 2u
            ? fp8_lane(packed, lane, 4u, 3u, 7)
            : fp8_lane(packed, lane, 5u, 2u, 15);
        uint groups_per_row = (params.k + params.group_size - 1u) / params.group_size;
        uint scale_index = output_row * groups_per_row + input_column / params.group_size;
        return value * bf16_scale(scale_index);
    }
    if (params.format_kind == 4u) {
        return e2m1_lane(packed, lane);
    }
    if (params.format_kind == 5u) {
        uint groups_per_row = (params.k + params.group_size - 1u) / params.group_size;
        uint scale_index = output_row * groups_per_row + input_column / params.group_size;
        return e2m1_lane(packed, lane) * e8m0_scale(scale_index);
    }
    if (params.format_kind == 7u) {
        uint nibble = (packed >> ((lane & 7u) * 4u)) & 0x0fu;
        uint groups_per_row = (params.k + params.group_size - 1u) / params.group_size;
        uint scale_index = output_row * groups_per_row + input_column / params.group_size;
        return float(int(nibble) - 8) * bf16_scale(scale_index);
    }
    uint byte_value = (packed >> ((lane & 3u) * 8u)) & 0xffu;
    return float(int(byte_value << 24u) >> 24) / 127.0;
}

void main() {
    uint first_local_column = gl_GlobalInvocationID.x * 2u;
    uint row = gl_GlobalInvocationID.y;
    if (row >= params.m || first_local_column >= params.local_n) {
        return;
    }

    vec2 accum = vec2(0.0);
    for (uint kk = 0u; kk < params.k; kk++) {
        uint activation_index = row * params.k + kk;
        uint packed_activation = activations.words[activation_index >> 1u];
        float activation = bf16_lane(packed_activation, activation_index);
        accum.x = fma(activation, weight_at(first_local_column, kk), accum.x);
        if (first_local_column + 1u < params.local_n) {
            accum.y = fma(
                activation,
                weight_at(first_local_column + 1u, kk),
                accum.y
            );
        }
    }
    uint output_column = params.output_column_offset + first_local_column;
    uint bits0 = floatBitsToUint(accum.x);
    uint bits1 = floatBitsToUint(accum.y);
    uint bf16_0 = (bits0 + 0x7fffu + ((bits0 >> 16u) & 1u)) >> 16u;
    uint bf16_1 = (bits1 + 0x7fffu + ((bits1 >> 16u) & 1u)) >> 16u;
    outputs.words[(row * params.global_n + output_column) / 2u] = bf16_0 | (bf16_1 << 16u);
}
