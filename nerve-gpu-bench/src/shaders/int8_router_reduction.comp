#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 64) in;
layout(push_constant) uniform Params {
    uint tokens;
    uint experts;
    uint input_offset;
    uint output_offset;
    uint logical_per_word;
    uint format_kind;
} params;
layout(std430, binding = 0) buffer Data {
    uint words[];
} data;

shared int partial_max[64];

int score_at(uint logical_index) {
    uint word = data.words[params.input_offset + logical_index / 4u];
    uint bits = (word >> ((logical_index & 3u) * 8u)) & 0xffu;
    return int(bits << 24u) >> 24;
}

void main() {
    uint token = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (token >= params.tokens) {
        return;
    }

    int maximum = -128;
    for (uint expert = lane; expert < params.experts; expert += 64u) {
        maximum = max(maximum, score_at(token * params.experts + expert));
    }
    partial_max[lane] = maximum;
    barrier();

    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            partial_max[lane] = max(partial_max[lane], partial_max[lane + stride]);
        }
        barrier();
    }
    if (lane == 0u) {
        data.words[params.output_offset + token] = floatBitsToUint(float(partial_max[0]));
    }
}
