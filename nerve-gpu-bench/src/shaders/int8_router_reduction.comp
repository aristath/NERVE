#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 64) in;
layout(push_constant) uniform Params {
    uint elements;
} params;
layout(std430, binding = 0) buffer Data {
    uint packed_values[];
} data;

uint8_t lane(uint value, uint shift) {
    return uint8_t((value >> shift) & 0xffu);
}

uint8_t reduce_lane(uint8_t value, uint8_t neighbor) {
    uint8_t high = value > neighbor ? value : neighbor;
    uint8_t low = value > neighbor ? neighbor : value;
    return high - low + uint8_t(19);
}

uint pack_lanes(uint8_t a, uint8_t b, uint8_t c, uint8_t d) {
    return uint(a) | (uint(b) << 8) | (uint(c) << 16) | (uint(d) << 24);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.elements) {
        return;
    }
    uint value = data.packed_values[index];
    uint neighbor = data.packed_values[(index * 17u + 13u) % params.elements];
    uint8_t a = reduce_lane(lane(value, 0u), lane(neighbor, 24u));
    uint8_t b = reduce_lane(lane(value, 8u), lane(neighbor, 16u));
    uint8_t c = reduce_lane(lane(value, 16u), lane(neighbor, 8u));
    uint8_t d = reduce_lane(lane(value, 24u), lane(neighbor, 0u));
    data.packed_values[index] = pack_lanes(a, b, c, d);
}
